    check("decode lone invalid byte", decoded(b"\xff"), "\ufffd")
    # latin-1 e-acute: valid as latin-1, not a valid UTF-8 sequence.
    check("decode latin-1 byte is replaced", decoded(b"\xe9"), "\ufffd")
    check("decode truncated multibyte is replaced", decoded("é".encode("utf-8")[:-1]), "\ufffd")
    # The property that actually matters: a bad byte inside a device name
    # costs that one name, not the whole document.
    check("decode keeps payload around a bad byte",
          decoded(b"Sink #0\n\tname = My \xff Speaker\nSink #1\n\tname = Fine\n"),
          "Sink #0\n\tname = My \ufffd Speaker\nSink #1\n\tname = Fine\n")
    check("decode bad byte at start", decoded(b"\xffname = Fine\n"), "\ufffdname = Fine\n")
    check("decode bad byte at end", decoded(b"name = Fine\n\xff"), "name = Fine\n\ufffd")
    # Every byte value, one at a time: no lone value may raise.
    check("decode survives all single bytes",
          all(decoded(bytes([i])) is not None for i in range(256)), True)
    check("decode full byte range is total", len(decoded(bytes(range(256)))), 256)

    # decode_output is only half the fix: run() has to actually route through
    # it. Testing the helper alone would still pass if someone reinstated
    # text=True, because the function would keep working while nothing called
    # it. These drive run() itself against a stubbed subprocess, so the suite
    # still runs with no real process and no pactl.
    class _Completed:
        def __init__(self, stdout):
            self.stdout = stdout

    seen = {}

    def fake_run(cmd, **kwargs):
        seen.clear()
        seen.update(kwargs)
        return _Completed(b"name = My \xff Speaker\n")

    real_subprocess_run = subprocess.run
    try:
        subprocess.run = fake_run
        check("run() decodes through the replacement policy",
              run(["ignored"]), "name = My \ufffd Speaker\n")
        # Pin the actual fix at its source: capture bytes, never text mode.
        # text=True or an explicit encoding restores the whole bug, because
        # Python's own decoder is strict about the same bytes.
        check("run() captures bytes, not text", seen.get("text"), None)
        check("run() sets no explicit encoding", seen.get("encoding"), None)
        check("run() captures stdout", seen.get("capture_output"), True)
    finally:
        subprocess.run = real_subprocess_run

    def exploding_run(cmd, **kwargs):
        raise OSError("no such command")

    try:
        subprocess.run = exploding_run
        check("run() still swallows spawn failure", run(["ignored"]), "")
    finally:
        subprocess.run = real_subprocess_run

    # A timeout is a spawn-level failure too: the caller gets "" and the panel
    # keeps its last good state rather than a traceback.
    try:
        subprocess.run = lambda cmd, **kw: (_ for _ in ()).throw(subprocess.TimeoutExpired(cmd, kw.get("timeout")))
        check("run() swallows timeout", run(["ignored"]), "")
    finally:
        subprocess.run = real_subprocess_run
    check("run() left the real subprocess.run in place", subprocess.run is real_subprocess_run, True)


    # The bug this pins: EXCLUDE_APPS held "Quickshell" and "wireplumber" while
