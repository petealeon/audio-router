        app_badge = qml_block("appBadge")
        out_badge = qml_block("outBadge")
        check("a shortcut hint is drawn on a filled keycap",
              "radius: Style.space(4)" in app_badge and "radius: Style.space(4)" in out_badge, True)
        check("and the keycap fill keeps an explicit alpha on the fill",
              "root.badgeFill(" in app_badge and "root.badgeFill(" in out_badge, True)
        check("the keycap letter stays centered and accent-coloured",
              "anchors.centerIn: parent" in app_badge and "anchors.centerIn: parent" in out_badge, True)
        # Geometry: the source keycap sits just left of the label with the same
        # label gap as the output keycap on the far side (both 6px), and the
        # output keycap is pinned to the row's right edge, clear of the patch
        # lines and the out-dot on the left.
        check("the source keycap matches the output keycap's spacing",
              "x: Style.space(10)" in app_badge and "width: Style.space(14)" in app_badge, True)
        check("the output keycap anchors to the right of the row",
              "anchors.right: parent.right" in out_badge and "anchors.rightMargin: Style.space(6)" in out_badge
              and "width: Style.space(14)" in out_badge, True)
        # The output label reserves the badge's width so a wrapped name never
        # slides under the right-hand keycap.
        check("the output label stops short of the keycap",
              "Style.space(26)" in qml_block("outLabel"), True)
        # The speaker glyph is gone: the row's own circle already signals an
        # active stream (bolder dot, full-weight name), and the icon used to
        # crowd the shortcut keycap's slot. Keep it gone -- the label pad it
        # once shared is now just that, a label pad.
        check("the speaker glyph stays gone from the source rows",
              "appSpeaker" not in panel_src, True)
        check("and the old gutter was renamed to a plain label pad",
              "speakerGutter" not in panel_src and "readonly property int labelPad" in panel_src, True)
        # Both columns share one Item, so its height covers whichever grid runs
        # longer. Sizing it from the app step alone clips the bottom of a longer
        # output list.
        check("the patch area is tall enough for the taller output rows",
              "root.outputRows.length * root.outRowStep" in qml_block("patchArea"), True)
        # Output names wrap rather than ellipsize, because an output name's tail
        # is the informative end. maximumLineCount is the floor under the row
        # height: without it a pathological name spills out of its row instead
        # of degrading to an ellipsis. Both scoped to the output label, since
        # the status note above wraps too and would satisfy a whole-file search.
        out_label = qml_block("outLabel")
        check("output labels wrap instead of eliding",
              "wrapMode: Text.WordWrap" in out_label, True)
        check("and keep a two-line floor so a long name cannot overflow",
              re.findall(r"maximumLineCount:\s*(\d+)", out_label), ["2"])
        # The output dot is vertically centred in the output row's content box.
        # A wrapped name reads as line 1 plus line 2, and the anchor for "the
        # route lands on this output" is the whole block, not its first line:
        # riding line 1 put the dot half a line box above the row middle, which
        # made every "straight across" link from a source go uphill. Scoped to
        # the dot's own block, and the row height is banned there outright: an
        # anchor to the parent's vertical centre already IS the row centre, so
        # adding outRowH on top would double-count the offset.
        out_dot = qml_block("outDot")
        check("the output dot is vertically centred in its row",
              "anchors.verticalCenter: parent.verticalCenter" in out_dot, True)
        check("and never re-reads the label's lines to position itself",
              "outLabel" in out_dot, False)
        check("and never mixes in the row height on top of the centring",
              "outRowH" in out_dot, False)
        # lineHeight is a multiplier under the default ProportionalHeight mode,
        # not pixels, so reaching for it here is guesswork either way. The old
        # formula derived the offset from the font size; the anchor does not.
        check("the output dot's position does not depend on the font size",
              "font.pixelSize" in out_dot, False)
        # One owner, one reader. The patch canvas draws its endpoint behind the
        # columns, so a connected output shows one dot only while the passive dot
        # and the line endpoint occupy the same pixel. A reader that recomputes
        # its own y brings the second dot straight back, so the reader has to be
        # the published map rather than a fresh row-centre calculation.
        check("a connected output cannot grow a second dot",
              "root.outDotCenterY(" in qml_fn("dotCenterFor"), True)
        check("the output dot's position has one owner and three readers",
              panel_src.count("root._outDotY["), 3)
        # Everything above is pointless if the published number is the dot's top
        # edge instead of its centre: the canvas then draws its endpoint 3px
        # above the passive dot, which is the same split the alignment fixes,
        # three times smaller. Both publish sites have to add the radius.
        check("the delegate publishes the dot's centre, not its top edge",
              [len(re.findall(r"noteOutDotY\(\s*\w+\.okey\s*,\s*outDot\.y\s*\+\s*3\s*\)", panel_src)),
               len(re.findall(r"noteOutDotY\(\s*\w+\.okey\s*,\s*y\s*\+\s*3\s*\)", panel_src))],
              [1, 1])
        # The dot's y used to depend on the label's lines, so a re-wrap moved it and
        # the published position had to follow. With vertical centring the dot
        # rides the row geometry instead, but the row geometry itself can still
        # change (theme or font-scale change to outRowH), and _outDotY is the
        # only source the canvas reads -- so the position still has to be
        # republished on a y change and not only when the delegate is built.
        check("the output dot republishes on any y change",
              "onYChanged: root.noteOutDotY(" in out_dot, True)
        # _outDotY is mutated in place, so the Canvas's dependency on it never
        # fires. Without an explicit repaint the line keeps pointing where the
        # dot used to be until something else happens to redraw the canvas.
        check("writing the output dot's position repaints the canvas",
              "repaintPatch()" in qml_fn("noteOutDotY"), True)
        # The canvas is declared after the columns, so it is still undefined
        # while the first row's delegate reports in. Calling requestPaint()
        # through an unguarded reference throws a TypeError per row on every
        # panel open, and the repaint is the only thing that call does -- the
        # position is already written by then, so the symptom is a silent
        # failure wrapped in a burst of errors, which is the worst kind.
        check("the repaint tolerates the canvas not existing yet",
              bool(re.search(r"if\s*\(\s*!root\.linkCanvas\s*\)\s*return", qml_fn("repaintPatch"))),
              True)
        # And it must coalesce: a panel full of rows reporting in the same frame
        # should cost one repaint, not one per row.
        check("the repaint coalesces a frame's worth of rows",
              bool(re.search(r"if\s*\(\s*root\._repaintQueued\s*\)\s*return", qml_fn("repaintPatch"))),
              True)
        # Row highlights. The fills are washes of the theme accent, read off a
        # real color (Color.accent), not the string-typed `accent` property:
        # .r/.g/.b on a JS string are all undefined, so the old Qt.rgba call
        # collapsed to transparent black and the highlight was invisible on
        # every theme. Guards below pin both halves: the sources feed the
        # two-tier fills, and no row may read the bare string's channels.
        check("row highlights are washes of the theme accent, not a string",
              "Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b" in panel_src, True)
        check("and the filled rows never read the string-typed accent channels",
              "Qt.rgba(root.accent.r" in panel_src, False)
        check("hover/cursor and selected rows use distinct tiers",
              "root.rowHoverFill" in panel_src and "root.rowSelectedFill" in panel_src, True)
        # A plain click arms click-to-click selection (selectKey) without a drag.
        # selectKey used to have no visual at all, so a chosen source vanished
        # the moment the cursor left it. It has to join the drag source in the
        # selected tier, and the selected tier carries an accent hairline so a
        # wash alone cannot be mistaken for a sleeping row on low-contrast
        # themes. Playing both sides of the two-tier ternary guards the tier
        # split itself -- if someone collapses it back to a single fill, the
        # border's grouping key will not match the fill's.
        app_row = qml_block("appDlg")
        check("the armed source joins the drag source in the selected tier",
              "root.selectKey === appDlg.dkey" in app_row, True)
        check("and the selected tier gets an accent hairline",
              "border.width: (root.dragKey === appDlg.dkey || root.selectKey === appDlg.dkey) ? 1 : 0" in app_row, True)
        check("while plain hover or cursor stays on the lighter wash",
              "root.hoverAppKey === appDlg.dkey ? root.rowHoverFill" in app_row, True)
        # The keyboard cursor parks on an output without any drag: syncCursorRow
        # sets hoverTarget for the outputs section. Gating the highlight on
        # `dragging` hid that row entirely, so a keyboard-selected output looked
        # exactly like every other idle row.
        out_row = qml_block("outDlg")
        check("an output row highlights for any hoverTarget, drag or cursor",
              "color: root.hoverTarget === outDlg.okey" in out_row, True)
        check("and only a live drag earns the stronger tier and the hairline",
              "root.dragging ? root.rowSelectedFill" in out_row, True)
        # A bare mouse hover over an output used to refresh only hoverAppKey
        # (the app column's key), so the output column stayed dark until a drag
        # or the keyboard cursor parked there. The hover handler must publish
        # the output list's key on position change too, and clear both hover
        # keys when the cursor leaves the patch, or a highlight sticks for good.
        p_mouse = qml_block("patchMouse")
        check("mouse hover over the output column sets hoverTarget",
              "root.hoverTarget = root.outputAt(m.x, m.y) || \"\"" in p_mouse, True)
        check("and mouse hover over the app column keeps hoverAppKey",
              "root.hoverAppKey = root.rowKeyAt(m.x, m.y)" in p_mouse, True)
        check("and leaving the patch clears both hover keys",
              "onExited: {" in p_mouse and 'root.hoverAppKey = ""' in p_mouse and 'root.hoverTarget = ""' in p_mouse, True)
    except OSError as ex:
        check("Panel.qml readable for the fold checks", f"unreadable: {ex}", "readable")

    # The whole payload, end to end, in the shape the panel consumes: the three
    # filtered collections plus the rules. Each filter has its own unit test, and
    # this is what catches one of them being dropped from cmd_list itself --
    # which is how a stack rule stayed in the payload while every predicate
    # around it was correct.
    real_run, real_rules, real_labels = run, load_rules, resolve_sink_labels

    def list_run(cmd, **kwargs):
        # run() returns decoded text, not a subprocess object: this stubs run()
        # itself, not subprocess.run().
        if cmd[1:] == ["list", "sinks"]:
            return CANONICAL_SINKS
        if cmd[1:] == ["list", "sink-inputs"]:
            return CANONICAL_INPUTS + STACK_INPUT + ALSA_APP_INPUT
        if cmd[1:] == ["list", "clients"]:
            return STACK_CLIENT
        if cmd[1:] == ["get-default-sink"]:
            return "alsa_output.pci-0000_00_1f.3.analog-stereo\n"
        return ""

    try:
        run = list_run
        load_rules = lambda: [
            {"app": "Brave", "binary": "brave", "node": "", "sink": "alsa_output.pci-0000_00_1f.3.analog-stereo"},
            {"app": "WirePlumber [client]", "binary": "wireplumber", "node": "",
             "sink": "bluez_output.24_06_11_A5_E7_95.1"},
            {"app": "PipeWire ALSA [cliamp]", "binary": "cliamp", "node": "",
             "sink": "alsa_output.usb-Generic_ThinkPad_Dock_USB_Audio-00.analog-stereo"},
        ]
        # No state file is read or written: label resolution is the one part of
        # cmd_list that touches disk, and the selftest has no business doing that.
        resolve_sink_labels = lambda sinks, rules: ({}, [])
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            cmd_list()
        payload = json.loads(buf.getvalue())
        ins = [e["appName"] for e in payload["sinkInputs"]]
        cls = [c["appName"] for c in payload["clients"]]
        # The stack is dropped, in all three collections.
        check("payload drops a pin naming the audio stack",
              [r["app"] for r in payload["rules"] if r["app"] == "WirePlumber [client]"], [])
        check("payload drops the stack's own stream",
              [n for n in ins if n.startswith("WirePlumber")], [])
        check("payload drops the stack from its clients",
              [n for n in cls if n.startswith("WirePlumber")], [])
        # A real application behind the same PipePipeWire wrapper is kept. These
        # two groups are one assertion split in two on purpose: an exclusion rule
        # broad enough to catch the first also caught the second, and that is how
        # an installed music player was removed from the panel.
        check("payload keeps a real app behind a PipeWire wrapper: its stream",
              "PipeWire ALSA [cliamp]" in ins, True)
        check("payload keeps a real app behind a PipeWire wrapper: its client",
              "PipeWire ALSA [cliamp]" in cls, True)
        check("payload keeps a real app behind a PipeWire wrapper: its pin",
              [r["app"] for r in payload["rules"] if r["app"] == "PipeWire ALSA [cliamp]"],
              ["PipeWire ALSA [cliamp]"])
        check("payload keeps a real app's stream and client",
              ["Brave" in ins, "Brave input" in cls], [True, True])
        check("payload still carries the bluetooth alias map",
              isinstance(payload.get("sinkAliases"), dict), True)
    finally:
        run, load_rules, resolve_sink_labels = real_run, real_rules, real_labels

    # The watcher's death classification, in BarWidget.qml. The logic is QML, so
    # it cannot be exercised here the way the Python above is; these are source
    # guards on the exact statements that were wrong, and they exist because a
    # hardcoded 0 on the stderr path was invisible to every other check in this
    # suite while turning every SIGKILL into a "tidy shutdown".
    try:
        with open(os.path.normpath(os.path.join(
                os.path.dirname(os.path.abspath(__file__)), os.pardir, "BarWidget.qml")),
                encoding="utf-8") as f:
            bar_src = qml_strip_comments(f.read())

        def bar_block(anchor):
            """The source text of the brace-balanced block opening at `anchor`."""
            start = bar_src.find(anchor)
            if start < 0:
                return ""
            depth, i = 0, bar_src.find("{", start)
            while i < len(bar_src):
                if bar_src[i] == "{":
                    depth += 1
                elif bar_src[i] == "}":
                    depth -= 1
                    if depth == 0:
                        return bar_src[start:i + 1]
                i += 1
            return ""

        def bar_fn(name):
            """The source text of one BarWidget.qml function, braces balanced."""
            return bar_block("  function %s(" % name)

        # The channel that fires first must not claim a code. It has none: 0 here
        # read as "clean exit" for every death the helper did not mark.
        _stderr = bar_block("stderr: StdioCollector {")
        check("the stderr exit path passes no code, not zero",
              re.search(r"_processExit\([^)]*,\s*(null|undefined)\s*\)", _stderr) is not None, True)
        check("the stderr exit path never hardcodes 0 as a code",
              re.search(r"_processExit\([^)]*,\s*0\s*\)", _stderr) is None, True)
        # The second channel is the only one that carries a code, and it must
        # actually pass it through rather than folding it into the reason.
        _onExited = bar_block("onExited: function(exitCode)")
        check("onExited forwards the real exit code",
              re.search(r"_processExit\(\s*\"\"\s*,\s*exitCode\s*\)", _onExited) is not None, True)
        # An unmarked death is unexplained, and unexplained is a crash: the
        # fall-through of the action table, reached by a null code as well as by
        # any signal. Only a real 0 from onExited is a clean self-exit.
        _action = bar_fn("_exitAction")
        check("a null code falls through to a crash, not to a stop",
              re.search(r"return\s+[\"']crash[\"']\s*\n\s*\}", _action) is not None, True)
        check("only an explicit 0 counts as a clean exit",
              re.search(r"code\s*===\s*0[\s\S]{0,80}?return\s+[\"']stop[\"']", _action) is not None,
              True)
        check("the action table still knows the three intentional exits",
              all(tok in _action for tok in ('"flock"', '"stop"', '"crash"'))
              and "code === 3" in _action and "code === 15" in _action
              and "code === 0" in _action, True)
        # The de-dup must compare decisions, so a second channel carrying the
        # real signal number still reaches _crash instead of being dropped.
        _exit = bar_fn("_processExit")
        check("the de-dup window suppresses only an identical action",
              re.search(r"action\s*===\s*root\._lastExitAction", _exit) is not None, True)
        check("the de-dup window still records what it decided",
              "root._lastExitAction = action" in _exit, True)
        # A crash supersedes a stop already decided for the same death, so the
        # 30s re-arm must not stay pending behind the 3s retry.
        check("a crash cancels the pending 30s re-arm",
              re.search(r"watchRearm\.stop\(\)[\s\S]*?_crash\(", _exit) is not None, True)
        # The crash budget is the point of classifying correctly at all: a
        # SIGKILL that takes the stop branch never increments it.
        check("a crash is the path that spends the restart budget",
              re.search(r"if \(action === \"stop\"\)[\s\S]*?return[\s\S]*?_crash\(", _exit) is not None,
              True)
    finally:
        pass

    # The marketplace security review pinned two file-safety properties, and
    # they are guarded here because a regression to either is invisible to the
    # behavioural checks above (the watcher still routes). A predictable temp
    # path next to the store is a symlink target that open("w") truncates; a
    # whole-directory rm -rf keyed on a name alone can delete content this
    # installer never owned.
    with open(os.path.abspath(__file__), encoding="utf-8") as _f:
        helper_src = _f.read()
    # Everything past the selftest's own header is test text (including these
    # guard lines), so cut it off before searching for the banned shapes.
    _production = helper_src.split("\ndef selftest(", 1)[0]
    # A temp that is merely renamed from a fixed name regresses the fix without
    # failing a single behaviour test, so pin the exclusive-create shape itself.
    check("store/state temps are created exclusively, never opened in place",
          ('open(tmp, "w")' not in _production
           and 'STORE + ".tmp"' not in _production
           and 'f"{STATE}.tmp.' not in _production), True)
    check("atomic_write builds its temp with mkstemp (O_EXCL)",
          "tempfile.mkstemp" in helper_src, True)
    check("atomic_write fsyncs before the atomic replace",
          "os.fsync(f.fileno())" in helper_src
          and "os.replace(tmp, path)" in helper_src, True)

    install_sh = os.path.normpath(os.path.join(
        os.path.dirname(os.path.abspath(__file__)), os.pardir, "install.sh"))
    try:
        with open(install_sh, encoding="utf-8") as _f:
            isrc = _f.read()
        # Marketplace security review, round 3. Both blockers in this block were
        # the legacy-id cleanup, and the fix was to delete that code rather than
        # make it safer: no superseded id is referenced at all, so install.sh
        # cannot auto-delete a directory it did not put there.
        check("install.sh references no legacy plugin id",
              ("peter.router" not in isrc and "LEGACY_IDS" not in isrc
               and "drop_legacy" not in isrc), True)
        # The second blocker was the shell.json bar-layout fallback writing to a
        # predictable "shell.json.router.tmp.<pid>" through a shell redirect,
        # which follows a symlink and truncates its target. That was the only
        # shell-side temp write in the installer; pin its shape so it cannot
        # come back with any name.
        check("install.sh has no predictable temp file write",
              (".tmp.$$" not in isrc and "router.tmp" not in isrc
               and re.search(r'>\s*"?\$tmp', isrc) is None), True)
        # What remains must still be an explicit, manifest-verified decision:
        # one directory removal, only under --remove/--purge, only when the
        # manifest declares this plugin's id. The other rm -rf prunes our own
        # ".petealeon.router.bak.*" glob and is not a user-content path.
        check("install.sh removes only its own manifest-verified dir",
              (len(re.findall(r'rm -rf "\$DEST"', isrc)) == 1
               and "elif [[ -d $DEST ]] && grep -q" in isrc
               and re.search(r'rm -rf "\$DEST"[\s\S]{0,400}?\$\{PLUGIN_ID\}"', isrc) is None), True)
    except OSError as _ex:
        check("install.sh readable for the deletion guards",
              f"unreadable: {_ex}", "readable")

    failed = [name for name, ok in checks if not ok]
    print(f"selftest: {len(checks) - len(failed)}/{len(checks)} passed")
    return 1 if failed else 0


def main():
    args = sys.argv[1:]
    if not args:
        say("usage: omarchy-router list | set-sink <app> <binary> <node> <sink|__default__>"
            " | set-rule <app> <binary> <node> <sink|__default__>"
            " | remove <app-or-binary> | restore | routing-state | set-routing <on|off>"
            " | watch | selftest")
        sys.exit(2)
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "set-sink" and len(rest) >= 4:
        cmd_set(rest[0], rest[1], rest[2], rest[3])
    elif cmd == "set-rule" and len(rest) >= 4:
        cmd_set_rule(rest[0], rest[1], rest[2], rest[3])
    elif cmd == "remove" and rest:
        cmd_remove(rest[0])
    elif cmd == "restore":
        cmd_restore()
    elif cmd == "routing-state":
        cmd_routing_state()
    elif cmd == "set-routing" and rest:
        cmd_set_routing(rest[0])
    elif cmd == "watch":
        cmd_watch()
    elif cmd == "selftest":
        sys.exit(selftest())
    else:
        say(f"unknown command or bad arguments: {cmd} {rest}")
        sys.exit(2)


if __name__ == "__main__":
    main()