#!/usr/bin/env python3
"""petealeon.router helper.

Subcommands:
  list                       emit the full routing state as one JSON line on stdout
  set-sink <app> <binary> <node> <sink|__default__>
                             persist a rule (removes it when sink is
                             __default__) and move matching active streams now
  remove <app-or-binary>     delete a rule and move matching streams to default
  restore                    move every valid stream back to the default sink;
                             non-zero exit if any stream fails to follow
  routing-state              print the persisted on/off intent ("on" or "off")
  set-routing <on|off>       persist that intent, so a shell reload does not
                             silently switch routing back on
  watch                      apply persisted rules on a 0.5s poll; exits when
                             the parent that spawned it is gone; flock-singleton
  selftest                   run the pure-function checks below (no pactl, no store)

When a rule's target device has disconnected (e.g. a Bluetooth sink), matching
streams are moved to the system default instead of being left muted on the
vanished device; the rule itself is kept, so the watcher routes them back the
moment the device returns.

State is stored at ~/.config/omarchy/router-rules.json:
  [ { "app": "Chromium", "binary": "chromium", "node": "",
      "sink": "alsa_output.pci-..." }, ...]
sink values are output NAMES (__default__ is never persisted).

The on/off switch is stored separately at ~/.config/omarchy/petealeon-router.json
as {"routing_enabled": true|false}, because it is a preference that has to
survive a shell reload. Missing or unreadable means on.

A rule stores whichever identity fields were visible at link time; streams are
matched in order of specificity: process-binary basename, then PipeWire
node.name basename, then application.name (trailing " input" ignored). Browser
streams often omit process.binary but always have a node.name, so the node key
is what keeps Brave/Chromium rules matching. EasyEffects is never steered.

Store writes are serialized with an flock: writers take LOCK_EX around the whole
read-modify-write, the watcher takes LOCK_SH for its reads, so two quick links
can never drop each other's rule.
"""

import fcntl
import contextlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
STORE = os.environ.get("ROUTER_STORE") or f"{os.path.expanduser('~')}/.config/omarchy/router-rules.json"
LOCK = f"{RUNTIME}/omarchy-router.store.lock"
WATCH_MARK = f"{RUNTIME}/omarchy-router.watch.lock"
LOG = f"{RUNTIME}/omarchy-router.watch.log"
# Bound the watch log, which lives on tmpfs and is therefore charged to the
# session's memory. One previous generation is kept so the failure that
# triggered rotation is still readable.
LOG_MAX_BYTES = 256 * 1024
# Routing on/off is a user preference, not derived state: it has to outlive the
# shell, because a reload otherwise silently switches routing back on. Lives
# beside the rule store in the config dir the plugin already owns.
STATE = os.environ.get("ROUTER_STATE") or f"{os.path.expanduser('~')}/.config/omarchy/petealeon-router.json"

# Exit codes that mean "intentional stop" rather than a crash. Shared contract
# with BarWidget.qml onExited: 0 = clean self-exit, 3 = flock conflict or parent
# gone, 15 = SIGTERM (the engine sends this on running=false and shell/config
# teardown). Quickshell reports signal deaths by raw signal number (a SIGKILL
# arrives as 9, not 137), so 143 is deliberately absent.
INTENTIONAL_EXITS = (0, 3, 15)

# Watcher poll cadence. Fast while anything is playing, since that is when a
# stream can start out on the wrong output and the user notices; slow when
# silent, where the only thing that can change is a device appearing.
POLL_ACTIVE = 0.5
POLL_IDLE = 2.5
# Keep polling fast briefly after the last stream ends, so a pause between
# tracks does not drop back to the slow cadence and miss the next one starting.
POLL_LINGER = 3.0

# Applications that are part of the audio stack itself, or are our own tooling.
# They are never steered: moving a wireplumber or portal stream would fight the
# session manager, and moving our own pactl calls is meaningless.
#
# Stored lowercase and compared through is_excluded_app, never by raw
# membership: pactl reports "WirePlumber" and "quickshell", so a set holding
# "wireplumber" and "Quickshell" silently matched neither and let both through
# as steerable. Kept in sync with Model.js's EXCLUDE_APPS by a selftest that
# asserts the two agree on the PREDICATE, not merely on the list of names --
# comparing lists was not enough, because both sides held identical names while
# still disagreeing about which names to reject.
EXCLUDE_APPS = {"easyeffects", "quickshell", "wireplumber", "pipewire", "systemd",
                "pactl", "pw-dump", "python3",
                "xdg-desktop-portal", "xdg-desktop-portal-hyprland"}

# PipeWire's wrapper name for a client that opened an ALSA PCM: the application
# is the bracketed part, not PipeWire. A live session here reports
# "PipeWire ALSA [cliamp]" for the terminal music player cliamp, whose binary is
# /usr/bin/cliamp -- a real, installed, routable application.
RE_ALSA_WRAPPER = re.compile(r'^pipewire\s+alsa\s+\[([^\]]{1,64})\]$', re.I)


def alsa_client_name(name):
    """The application named inside a "PipeWire ALSA [app]" wrapper, else "".

    The other half of why EXCLUDE_APPS matches exact names: the wrapper is not
    the stack, it is the application it carries, so "PipeWire ALSA [cliamp]" is
    an installed music player and not plumbing.
    """
    m = RE_ALSA_WRAPPER.match((name or "").strip())
    return m.group(1).strip() if m else ""


# There is deliberately no namespace rule beside this list -- see
# is_excluded_app() for why a first-word match was removed rather than kept. A
# name added here is a name a real session has been seen to report.

RE_APP = re.compile(r'^application\.name\s*=\s*"(.*)"')
RE_BIN = re.compile(r'^application\.process\.binary\s*=\s*"(.*)"')
RE_NODE = re.compile(r'^node\.name\s*=\s*"(.*)"')
RE_SINK = re.compile(r'^Sink:\s*(\d+)')
RE_VOL = re.compile(r'^Volume:\s+(?:\S+\s*:\s*)?(\d+)\s*/\s*(\d+)%')
RE_VOL2 = re.compile(r'^Volume:\s+(\d+)%')
RE_MUTE = re.compile(r'^Mute:\s*(yes|no)')


def say(msg):
    sys.stderr.write(f"omarchy-router: {msg}\n")
    sys.stderr.flush()


def say_exit(msg, reason):
    # Human-readable line + lifecycle marker delivered in ONE stderr write so
    # both always survive process teardown (quickshell's collector has been
    # observed dropping bytes written in a separate flush immediately before a
    # clean exit). The marker must come first: the widget dispatches on it.
    sys.stderr.write(f"__WATCH_EXIT {reason}\nomarchy-router: {msg}\n")
    sys.stderr.flush()


def decode_output(raw):
    """Decode subprocess bytes, never losing the whole payload to one bad byte.

    Pactl's output carries device and application names, which come from
    arbitrary user-controlled metadata. A single invalid UTF-8 sequence used to
    raise out of the decode and, because run() swallows every exception into "",
    blank the entire panel -- one weird byte in one app name cost the user
    every device. Replacing the bad bytes keeps the rest of the document, which
    is what a name field can absorb: a device shows as "<name>\\ufffd" and stays
    usable instead of the list vanishing.

    Kept as a separate function so the selftest can pin the policy with no
    subprocess and no pactl.
    """
    return (raw or b"").decode("utf-8", "replace")


def run(cmd, timeout=4):
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=timeout)
        return decode_output(r.stdout)
    except Exception:
        return ""


def strip_deleted(s):
    """Drop PipeWire's " (deleted)" artifact from an identity string.

    When a process's on-disk executable is replaced under it (a browser
    updating itself, a package upgrade), PipeWire reports the binary as
    "brave (deleted)". That string is not a binary name, and letting it through
    splits one app into two identities: the live stream keys on
    "brave (deleted)" while the client and the stored rule key on "brave", so
    the panel shows a duplicate row and the rule matcher silently falls through
    to a weaker field. Stripped here, at the single funnel every identity
    passes through, so it can never be stored or compared.

    The marker is matched case-insensitively; the rest of the name keeps its
    case.
    """
    s = s or ""
    return s[:-len(" (deleted)")].rstrip() if s.lower().endswith(" (deleted)") else s


# A trailing bracketed tag on a PipeWire application name, e.g. the
# "WirePlumber [client]" a live session reports alongside the plain
# "WirePlumber" for the same binary. See norm_client_name.
CLIENT_TAG_RE = re.compile(r"\s*\[[^\]]{0,64}\]\s*$")


def basename(p):
    return strip_deleted((p or "").rsplit("/", 1)[-1])


# A bluetooth output sink is named after the device MAC plus a profile index:
# bluez_output.24_06_11_A5_E7_95.1 -> 24:06:11:A5:E7:95. The index is optional
# so a variant spelling still resolves, and matching on the device part means a
# label survives the profile moving from .1 to .2.
BLUETOOTH_SINK_RE = re.compile(r"^bluez_output\.([0-9A-Fa-f_]+)(?:\.\d+)?$")


def mac_from_sink(name):
    """The MAC behind a bluez_output sink name, or None for anything else."""
    m = BLUETOOTH_SINK_RE.match((name or "").strip())
    return m.group(1).replace("_", ":").upper() if m else None


def bluetooth_labels():
    """{MAC: name} for the devices BlueZ knows.

    A bluez_output sink can only exist for a paired device, so BlueZ always has
    a name for one — which is the whole point: the sink is gone from pactl
    exactly when the user wants to see the name.

    Returns None to mean "could not ask", deliberately distinct from {} meaning
    "asked, knows nothing". Only the latter may be cached, or a bluetoothctl
    that failed once (daemon restarting, package upgrading) would pin the raw
    sink name for good.
    """
    if shutil.which("bluetoothctl") is None:
        return None
    out = run(["bluetoothctl", "devices"])
    if not out.strip():
        return None
    labels = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[0] == "Device":
            labels[parts[1].upper()] = " ".join(parts[2:])
    return labels


def resolve_sink_labels(sinks, rules):
    """(labels, pending) for the sinks the panel may need to name.

    `labels` maps sink name -> friendly name, covering every connected sink
    (PipeWire's own Description) plus every sink a rule points at that pactl
    does not currently report — which is how a disconnected bluetooth output
    reaches the panel at all, and why its row would otherwise be labelled with
    the raw bluez_output string.

    Absent sinks resolve remembered-description first, then BlueZ by MAC, then
    nothing: the panel applies its own last-resort formatting rather than being
    handed a guess from here.

    `pending` is what should be written to the state file: descriptions newly
    seen, and BlueZ answers. Empty strings are included on purpose — they record
    "asked, does not know" so the lookup runs at most once per device instead of
    on every one of the panel's 1s polls. Nothing is returned for a lookup that
    could not be made.
    """
    state = load_state()
    remembered = state.get("sinkLabels")
    remembered = remembered if isinstance(remembered, dict) else {}
    tried = state.get("tried")
    tried = set(tried) if isinstance(tried, list) else set()

    labels, pending = {}, {}
    for s in sinks:
        desc = (s.get("desc") or "").strip()
        if desc and desc != s["name"]:
            labels[s["name"]] = desc
            if remembered.get(s["name"]) != desc:
                pending[s["name"]] = desc

    present = {s["name"] for s in sinks}
    absent = []
    for r in rules:
        name = r.get("sink") or ""
        if name and name != "__default__" and name not in present and name not in absent:
            absent.append(name)

    table = None
    for name in absent:
        # `in remembered` rather than a truth test: a cached empty string means
        # "asked, does not know" and must still be emitted, or the key would
        # appear on one poll and vanish on the next, changing the payload shape
        # every second and forcing a pointless panel rebuild.
        if name in remembered:
            labels[name] = remembered[name]
            continue
        if name in tried:
            labels[name] = ""
            continue
        mac = mac_from_sink(name)
        if mac is None:
            continue
        if table is None:
            table = bluetooth_labels()
            if table is None:
                break  # could not ask: cache nothing, retry on a later poll
        answer = table.get(mac, "")
        labels[name] = answer
        pending[name] = answer
    return labels, pending


# One-line diagnostics about the store, surfaced through `list`'s error field.
# Mutable container so plain functions can set it without a `global` dance.
STORE_ISSUE = [""]
# Set once a corrupt rules file has been dealt with, so a store that stays
# unreadable is reported once instead of on every poll (see preserve_corrupt_store).
_CORRUPT_REPORTED = [False]


def load_rules():
    """Read the rules store. A missing file returns []. A corrupt or
    wrong-shaped file is never silently overwritten: a corrupt file is first
    renamed to ``router-rules.json.corrupt.<ts>`` and the problem is recorded
    in STORE_ISSUE for the panel to show.

    The rename is attempted at most once per process. The watcher reads the
    store on every poll, so a store that stays corrupt — an unwritable config
    dir, say, where the rename keeps failing — otherwise retried the
    preservation attempt twice a second forever, and the user saw a
    "preserved as ..." message that was never true.
    """
    try:
        with open(STORE, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, list):
            STORE_ISSUE[0] = "router-rules.json root is not a list; treated as empty"
            return []
        # Elements are filtered, not validated-and-rejected. A list of dicts is
        # what we write, so anything else is a hand-edit, a bad merge or a
        # foreign writer. Every consumer below calls .get() on a rule, so one
        # bare string in the list raised AttributeError inside identity_set --
        # which killed `list`, `set-sink` and the watcher's re-assert alike. The
        # panel then received no payload at all and showed a blank patchbay
        # with nothing in the log to explain it. Keeping the good elements means
        # one bad entry costs the user that entry and a visible warning, rather
        # than every pin they had.
        #
        # The file on disk is left exactly as it is: dropping the element from
        # the in-memory view is not the same as deleting the user's data, and
        # only write_rules() is allowed to rewrite the store. A user who fixes
        # the entry by hand keeps every other pin.
        good = [r for r in data if isinstance(r, dict)]
        if len(good) != len(data):
            STORE_ISSUE[0] = (
                f"router-rules.json holds {len(data) - len(good)} entry/entries that are not "
                f"rule objects; ignored (the file itself is unchanged)"
            )
        else:
            # Cleared, not left to persist. The watcher re-reads on every poll, so
            # a user who fixed the entry by hand would otherwise keep seeing a
            # complaint about a problem they had already resolved, until the
            # shell was reloaded.
            STORE_ISSUE[0] = ""
        return good
    except FileNotFoundError:
        return []
    except Exception:
        backup = preserve_corrupt_store()
        if backup:
            STORE_ISSUE[0] = f"router-rules.json was unreadable; preserved as {os.path.basename(backup)}"
        else:
            STORE_ISSUE[0] = (
                "router-rules.json was unreadable and could NOT be preserved — the file "
                "was left in place. Fix or remove it by hand; nothing will be overwritten "
                "until then."
            )
        return []


def preserve_corrupt_store():
    """Move an unreadable rules file aside, once. Returns the new path, or None.

    Returning None is a real outcome, not an error: if the rename cannot
    happen the corrupt file is still on disk untouched, which is the safe
    state. Saying it was "preserved" when it was not would send the user
    looking for a backup that does not exist.
    """
    if _CORRUPT_REPORTED[0]:
        return None
    _CORRUPT_REPORTED[0] = True
    backup = f"{STORE}.corrupt.{time.strftime('%Y%m%d%H%M%S')}"
    try:
        os.replace(STORE, backup)
        return backup
    except OSError as ex:
        say(f"could not preserve unreadable {STORE}: {ex}")
        return None


def atomic_write(path, text):
    """Atomically replace `path` with `text` without ever clobbering a file
    that was not meant to be written.

    A predictable temp path next to the store is a symlink target: if an
    attacker (or a stale file) sits there, open("w") follows the link and
    truncates whatever it points at before the replace lands. mkstemp instead
    creates a fresh name with O_CREAT|O_EXCL in the same directory -- the only
    path it opens is one it just created -- and the rename below is atomic, so
    a crash leaves either the old or the new file, never a torn one. The data
    is fsynced before the rename so a power cut cannot leave the real file
    replaced by a truncated temp.
    """
    directory = os.path.dirname(path)
    os.makedirs(directory or ".", exist_ok=True)
    fd, tmp = tempfile.mkstemp(
        prefix=os.path.basename(path) + ".tmp.", dir=directory or ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_rules(rules):
    atomic_write(STORE, json.dumps(rules, indent=2))


def parse_sinks(raw):
    sinks, cur = [], None
    for line in raw.splitlines():
        if line.startswith("Sink #"):
            if cur and cur["name"]:
                sinks.append(cur)
            idx = line.split("#", 1)[1].strip().split()[0]
            cur = {"index": idx, "name": "", "desc": "", "available": True}
        elif cur:
            t = line.strip()
            if t.startswith("Name: "):
                cur["name"] = t[6:].strip()
            elif t.startswith("Description: "):
                cur["desc"] = t[13:].strip()
            elif t.startswith("State: "):
                cur["available"] = t[7:].strip().upper() in ("RUNNING", "IDLE", "SUSPENDED")
    if cur and cur["name"]:
        sinks.append(cur)
    return sinks


def parse_inputs(raw, sink_by_index):
    out, cur = [], None
    for line in raw.splitlines():
        s = line.strip()
        if s.startswith("Sink Input #"):
            if cur:
                out.append(cur)
            cur = {"id": s[12:], "appName": "", "binary": "", "nodeName": "", "sink": "", "sinkName": "", "volume": 0.0, "muted": False}
        elif cur:
            m = RE_APP.match(s)
            if m:
                cur["appName"] = m.group(1)
                continue
            m = RE_BIN.match(s)
            if m:
                cur["binary"] = basename(m.group(1))
                continue
            m = RE_NODE.match(s)
            if m:
                cur["nodeName"] = m.group(1)
                continue
            m = RE_SINK.match(s)
            if m:
                cur["sink"] = m.group(1)
                continue
            m = RE_VOL.match(s)
            if m:
                cur["volume"] = int(m.group(2)) / 100.0
                continue
            m = RE_VOL2.match(s)
            if m:
                cur["volume"] = int(m.group(1)) / 100.0
                continue
            m = RE_MUTE.match(s)
            if m:
                cur["muted"] = m.group(1).lower() == "yes"
    if cur:
        out.append(cur)
    for e in out:
        e["sinkName"] = sink_by_index.get(e["sink"], {}).get("name", "")
    return out


def parse_clients(raw):
    out, seen, cur = {}, set(), {}

    def finish():
        app = cur.get("appName", "")
        if app and not is_excluded_client(cur):
            key = (cur.get("binary") or app).lower()
            if key not in seen:
                seen.add(key)
                out[key] = {"appName": app, "binary": cur.get("binary", "")}

    for line in raw.splitlines():
        if line.startswith("Client #"):
            finish()
            cur = {}
            continue
        s = line.strip()
        m = RE_APP.match(s)
        if m:
            cur["appName"] = m.group(1)
            continue
        m = RE_BIN.match(s)
        if m:
            cur["binary"] = basename(m.group(1))
    finish()
    return list(out.values())


def is_valid_input(e):
    return not is_excluded_client(e)


def norm(s):
    return (s or "").strip().lower()


def norm_client_name(s):
    """Normalise an application name for exclusion checks.

    PipeWire tags some client names with a bracketed suffix. A live session here
    reports both "WirePlumber" and "WirePlumber [client]" for the same binary,
    so an exclusion list that matched the raw string caught one spelling and
    let the other through — the audio stack stayed steerable. Drop any trailing
    bracket tag before comparing.
    """
    return norm(CLIENT_TAG_RE.sub("", s or ""))


def is_excluded_app(name):
    """True for the audio stack and our own tooling, case-insensitively.

    Single predicate for every call site: parse_clients (which rows the panel
    may offer), is_valid_input (what the watcher will steer and what restore
    will move), and the list payload's rule filter. They must agree — a row the
    panel offers but the matcher refuses to move is a dead end for the user, and
    the reverse is a stream being dragged somewhere nobody asked for.

    Exact match on the tag-stripped name, and nothing else. This used to be
    "or the first word is one of the stack's namespaces", a rule to catch stack
    names not yet seen. It is gone because it could not be tested against any
    name a real session reports — every one of them is already in EXCLUDE_APPS —
    while still being free to over-match, and over-matching is how it removed a
    real installed application (cliamp, reported as "PipeWire ALSA [cliamp]") from
    the panel. A name added to EXCLUDE_APPS is a name someone has actually seen.
    """
    return norm_client_name(name) in EXCLUDE_APPS


def is_excluded_client(e):
    """True when a stream belongs to the audio stack, by name or by binary.

    Both fields are consulted because either can identify the stack: WirePlumber
    arrives as the appName "WirePlumber [client]", and a stream that reports an
    unfamiliar appName but a binary of "wireplumber" is just as much the session
    manager. The panel filters its rows the same way, so the two agree.
    """
    return (is_excluded_app(e.get("appName", ""))
            or is_excluded_app(basename(e.get("binary", ""))))


def is_excluded_rule(r):
    """True for a stored pin that names the audio stack.

    A pin made before the stack was excluded still points at an internal node.
    It cannot be honoured, so the list payload drops it: the panel shows neither
    a row for it nor the ghost output row for the sink it was aimed at, and the
    user is not left with a routing that silently never happens. The rule stays
    on disk until the user removes it, so nothing of theirs is deleted here.
    """
    return is_excluded_app(r.get("app", "")) or is_excluded_app(basename(r.get("binary", "")))


def strip_input(s):
    s = s or ""
    if s.lower().endswith(" input"):
        t = s[: -len(" input")].rstrip()
        s = t if t else s
    # After the " input" removal, not before: a browser input client reports as
    # "Brave (deleted) input", so the artifact sits inside, not at the end.
    return strip_deleted(s)


def key_of_r(r):
    if not r:
        return ""
    b = norm(basename(r.get("binary", "")))
    if b:
        return b
    n = norm(basename(r.get("node", "")))
    if n:
        return n
    return norm(strip_input(r.get("app", "")))


def identity_set(r):
    """Every normalised name a record answers to, as a list.

    An app is the set of identities its records agree on, and two records are the
    same app when those sets intersect. Order of specificity: process-binary
    basename, then node.name basename, then application.name with a trailing
    " input" ignored, then the application named inside a "PipeWire ALSA [app]"
    wrapper. Mirrors identityList() in Model.js.
    """
    b = norm(basename(r.get("binary", "")))
    n = norm(basename(r.get("nodeName", "") or r.get("node", "")))
    a = strip_input(r.get("appName", "") or r.get("app", ""))
    out = []
    if b:
        out.append(b)
    if n and n != b:
        out.append(n)
    if a and norm(a) != b and norm(a) != n:
        out.append(norm(a))
    w = norm(alsa_client_name(a))
    if w and w not in out:
        out.append(w)
    return out


def identities_overlap(a, b):
    """True when two identity dicts (either rule shape {app,binary,node} or
    stream shape {appName,binary,nodeName}) name the same app.

    Set intersection, so any one shared name is enough. That last identity is
    what lets `remove cliamp` find a rule stored as "PipeWire ALSA [cliamp]":
    the name a person types is the one the panel shows them, and it is not
    necessarily the name the rule was written with.
    """
    sa = identity_set(a)
    if not sa:
        return False
    for name in sa:
        if name in identity_set(b):
            return True
    return False


def match_rule(e, rules):
    for r in rules:
        if identities_overlap(e, r):
            return r
    return None


def acquire_ex(fd, timeout=5.0):
    end = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except OSError:
            if time.monotonic() >= end:
                say(f"could not acquire store lock within {timeout}s")
                return False
            time.sleep(0.02)


def open_lock():
    """Open the store lock file, or return None when no lock is usable.

    The primary location is $XDG_RUNTIME_DIR, which is right in a normal
    systemd-backed session: the lock then disappears on logout instead of
    outliving it. But that directory does not exist outside a user session
    (a bare container, some CI contexts), and opening it there raised out of
    the caller as an unhandled OSError — a traceback instead of a decision.

    Falling back to a lock beside the store keeps writes working there. The
    fallback is safe because the failure is a property of the directory, not of
    one process: if the runtime path is unwritable it is unwritable for every
    writer, so they all choose the same lock and still exclude each other.
    """
    fallback = os.path.join(os.path.dirname(STORE) or ".", "omarchy-router.store.lock")
    for path in (LOCK, fallback):
        try:
            return open(path, "a", encoding="utf-8")
        except OSError:
            continue
    return None


def read_store_locked():
    rules = []
    fd = open_lock()
    if fd is None:
        # A read is safe to do unlocked: load_rules is a plain read plus an
        # atomic rename in the corrupt case, neither of which can lose a
        # concurrent writer's data the way an unlocked write can.
        return load_rules()
    try:
        with fd:
            fcntl.flock(fd, fcntl.LOCK_SH)
            rules = load_rules()
    except Exception:
        rules = load_rules()
    return rules


def modify_store(mutator):
    # Create the config directory before looking for a lock: the fallback lock
    # lives beside the store, so on a fresh install the directory it needs does
    # not exist yet and the write would be refused for a store we are about to
    # create anyway. A directory that cannot be created is a refusal, not a
    # traceback -- callers treat the result as a decision.
    try:
        os.makedirs(os.path.dirname(STORE) or ".", exist_ok=True)
    except OSError as ex:
        say(f"store: could not create {os.path.dirname(STORE)}: {ex}")
        wlog(f"refused store write: cannot create store dir: {ex}")
        return False
    fd = open_lock()
    if fd is None:
        say("store lock unavailable — refusing write")
        wlog("refused store write: no usable lock path")
        return False
    with fd:
        if not acquire_ex(fd):
            # Never perform an unlocked read-modify-write: two concurrent
            # writers could each drop the other's rule. Skip and surface it.
            say("store lock unavailable — refusing write")
            wlog("refused store write: lock unavailable after 5s")
            return False
        write_rules(mutator(load_rules()))
    return True


def move(id_, sink_name):
    if not id_ or not sink_name:
        return
    run(["pactl", "move-sink-input", id_, sink_name], timeout=2)


def poll_delay(has_streams, now, active_until):
    """Seconds to wait before the next watcher poll.

    Fast while anything is playing, slow when silent. The fast cadence only
    matters when a stream can start out on the wrong output, which is exactly
    when something is playing; when the session is silent the only thing that
    can change is a device appearing, and 2.5s is imperceptible for that. The
    old fixed 0.5s cost ~4 pactl spawns a second, ~1.9% of a core, for the whole
    session regardless of whether any audio existed.

    active_until is a monotonic deadline, not a flag: after the last stream
    ends the cadence stays fast for POLL_LINGER seconds, so a pause between
    tracks does not drop to the slow cadence and then miss the next track
    starting during it.
    """
    return POLL_ACTIVE if (has_streams or now < active_until) else POLL_IDLE


def wlog(msg):
    """Append a line to the watcher log, keeping the file strictly bounded.

    The log lives on tmpfs, so an unbounded one is memory the session never gets
    back: a watcher left running over a long session previously wrote unbounded
    lines at ~2/second. One previous generation is kept, so the failure that
    triggered rotation is still readable.

    The incoming line is measured before the rotation decision, not after.
    Testing the size first and writing second let a file sit past the cap until
    the *next* call came along, so the bound was "cap plus whatever accumulated
    in between" rather than the cap. With a single line also truncated, every
    generation now provably ends at or below LOG_MAX_BYTES: a line is only
    appended when it fits, and a line that can never fit is shortened.
    """
    try:
        line = f"[{time.strftime('%T')}] {msg}\n"
        if len(line) > LOG_MAX_BYTES // 2:
            line = line[:LOG_MAX_BYTES // 2] + " ...[truncated]\n"
        if os.path.exists(LOG) and os.path.getsize(LOG) + len(line) > LOG_MAX_BYTES:
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(line)
    except OSError:
        pass


def bluetooth_profile_index(name):
    """Trailing profile number of a bluez_output sink, or 0 when absent."""
    m = re.search(r"\.(\d+)$", (name or "").strip())
    return int(m.group(1)) if m else 0


def same_device_sink(target, sinks):
    """Live sink name for the same physical device under another profile.

    PipeWire's Bluetooth profile index is not stable across reconnects. A card
    that comes back as profile 2 instead of profile 1 exposes the very same
    speaker under a different sink name, so a rule stored as ".1" no longer
    matches by name -- which reads as "the device vanished". The rule then fell
    through to the default sink: audio played out of the laptop while the panel
    still showed the app pinned to the headset, and re-plugging the headset
    would not fix it because the rule kept failing the same name comparison.

    Matching on the MAC instead follows the device rather than the profile
    index, so the rule survives a re-index. Deliberately narrow: Bluetooth
    sinks only, since mac_from_sink returns None for everything else, and only
    same-device candidates, because a wrong match would move a stream to a
    speaker the rule never named.

    A device can expose more than one profile at once (A2DP alongside HFP), so
    when several same-MAC sinks are live the lowest profile index wins, matching
    PipeWire's own preference for the high-quality profile and keeping the
    choice stable across polls. Ties fall back to name order.
    """
    mac = mac_from_sink(target)
    if not mac:
        return ""
    matches = [s["name"] for s in sinks if mac_from_sink(s.get("name")) == mac]
    if not matches:
        return ""
    return sorted(matches, key=lambda n: (bluetooth_profile_index(n), n))[0]


def effective_sink(target, sinks, default=None):
    """Sink name to actually steer a stream to for a persisted rule.

    If the rule's target device is currently present, return it unchanged.
    If the same device reappeared under a different Bluetooth profile index,
    return that: it is the speaker the rule was written for, and following the
    index would silently divert audio to the default sink.
    If the device is genuinely gone, return the live default sink instead — the
    stream is never left muted on a vanished device, and the rule itself is
    preserved so the next poll with the device present re-asserts it. Returns ""
    when neither the target nor the default is usable. `default` is injectable
    for tests; when None it is read from pactl.
    """
    if not target:
        return ""
    names = {s["name"] for s in sinks}
    if target in names:
        return target
    alias = same_device_sink(target, sinks)
    if alias:
        return alias
    if default is None:
        default = run(["pactl", "get-default-sink"]).strip() or ""
    if default in names:
        return default
    return ""


def due(last_ts, now, interval):
    """Pure rate-limit decision: True when `now` is at least `interval`
    seconds after `last_ts`, or when `last_ts` is None (first occurrence).
    The caller owns the timestamp."""
    return last_ts is None or now - last_ts >= interval


def merge_issues(issues, store_issue):
    """Combine pactl diagnostics with the store issue, deduplicated."""
    out = list(issues)
    if store_issue and store_issue not in out:
        out.append(store_issue)
    return out


def describe_issues(sinks_raw, pactl_found):
    """Diagnostics for a degraded pactl read. An empty sink-inputs list is a
    normal idle state, so only the sink read and pactl's presence matter.
    Pure: feeds ``list``'s ``error`` field and the selftest."""
    issues = []
    if not pactl_found:
        issues.append("pactl not found")
    elif not sinks_raw:
        issues.append("pactl returned no sink data")
    return issues


def sink_alias_map(rules, sinks):
    """{stale rule target: live sink name} for the same device re-indexed.

    A rule naming ".1" for a card that came back as ".2" is still satisfied —
    effective_sink follows the MAC — so the panel must not also draw the
    connected row for ".2" and a disconnected ghost row for the rule's ".1".
    That pairing would show one headset twice and imply the app was not routed.

    Only rules whose target is absent from `sinks` and that resolve to a live
    same-device sink appear here; a wired target never matches, and a device
    that is genuinely gone must keep its ghost row, since that row is how the
    user learns their headset is unplugged.
    """
    names = {s["name"] for s in sinks}
    aliases = {}
    for r in rules:
        target = r.get("sink")
        if not target or target in names or target == "__default__":
            continue
        alias = same_device_sink(target, sinks)
        if alias:
            aliases[target] = alias
    return aliases


def cmd_list():
    sinks_raw = run(["pactl", "list", "sinks"])
    inputs_raw = run(["pactl", "list", "sink-inputs"])
    sinks = parse_sinks(sinks_raw)
    sink_by_index = {s["index"]: s for s in sinks}
    inputs = parse_inputs(inputs_raw, sink_by_index)
    clients = parse_clients(run(["pactl", "list", "clients"]))
    default_sink = run(["pactl", "get-default-sink"]).strip()
    rules = load_rules()
    # A pin that names the audio stack can never be honoured, so it is not
    # offered. The rule stays on disk (see is_excluded_rule); dropping it here
    # only keeps the panel from drawing a row the watcher would refuse to move.
    rules = [r for r in rules if not is_excluded_rule(r)]
    labels, pending = resolve_sink_labels(sinks, rules)
    if pending:
        # `list` is a read, so this is a side effect worth stating plainly: it
        # only happens when a label is genuinely new, and it is what lets a
        # disconnected device be named later without asking BlueZ again.
        def cache_labels(obj):
            cache = obj.get("sinkLabels")
            cache = dict(cache) if isinstance(cache, dict) else {}
            cache.update(pending)
            done = obj.get("tried")
            done = set(done) if isinstance(done, list) else set()
            return {**obj, "sinkLabels": cache, "tried": sorted(done | set(pending))}

        modify_state(cache_labels)
    # Tell the panel which rule targets are really the same device under a
    # different Bluetooth profile index, so it can suppress the duplicate ghost
    # row (see sink_alias_map).
    payload = {
        "sinks": sinks,
        "defaultSink": default_sink,
        "sinkInputs": [e for e in inputs if is_valid_input(e)],
        "clients": clients,
        "rules": rules,
        "labels": labels,
        "sinkAliases": sink_alias_map(rules, sinks),
    }
    issues = merge_issues(
        describe_issues(sinks_raw, shutil.which("pactl") is not None),
        STORE_ISSUE[0],
    )
    if issues:
        payload["error"] = "; ".join(issues)
    print(json.dumps(payload))
    sys.stdout.flush()


def replace_rule(rules, app, binary, node, sink):
    """Store mutation for a pin/unpin: drop any rule naming the same app
    (matched by identity, not just key, so a rule pinned before its
    process.binary appeared still gets replaced) and persist the new one
    unless the sink is __default__."""
    pin = {"app": app, "binary": basename(binary or ""), "node": node}
    kept = [r for r in rules if not identities_overlap(pin, r)]
    if sink != "__default__":
        kept.append({"app": app, "binary": basename(binary or ""), "node": node, "sink": sink})
    return kept


def acquire_watch_lock(retries=25, delay=0.2):
    """Take the watcher's flock, or return None.

    The watcher releases it the instant it dies (the kernel drops flocks when
    the fd closes), so this normally succeeds on the first try once the watcher
    is gone. It is polled rather than blocked on so a still-running watcher
    cannot hang the caller forever, and so the caller can report the failure
    instead of appearing to succeed.
    """
    try:
        mark = open(WATCH_MARK, "w")
    except OSError:
        return None
    for _ in range(retries):
        try:
            fcntl.flock(mark, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return mark
        except OSError:
            time.sleep(delay)
    mark.close()
    return None


def restore_result(status, detail=""):
    # Machine-readable summary on stdout. The widget cannot rely on
    # Process.onExited to learn the outcome: Quickshell drops that signal for
    # clean non-zero exits, which is exactly the shape of a failed revert. A
    # token in the collected stdout always arrives, so the off-switch can be
    # driven from this instead of from an exit code that may never be seen.
    sys.stdout.write(f"RESTORE_RESULT {status}{(' ' + detail) if detail else ''}\n")
    sys.stdout.flush()


def cmd_restore():
    # Restore all valid sink inputs to the system default sink, without touching
    # the stored rules. Flock the watch lock (bounded) so the watcher cannot
    # concurrently re-assert pins while we're moving streams.
    #
    # This is the whole off-switch, so it must never look successful when it
    # did not: the widget drives its switch from this result, and "moved 0"
    # used to be indistinguishable from a clean revert. Every failure path here
    # is an error result, and the final state is re-read and checked rather than
    # assumed.
    mark = acquire_watch_lock()
    if mark is None:
        restore_result("error", "watcher still running")
        say_exit("restore: could not acquire watch lock — is the watcher still running?", "flock")
        sys.exit(3)
    try:
        default = run(["pactl", "get-default-sink"]).strip()
        if not default:
            restore_result("error", "no default sink")
            say_exit("restore: pactl could not report a default sink", "pactl")
            sys.exit(5)
        sinks = parse_sinks(run(["pactl", "list", "sinks"]))
        sink_by_index = {s["index"]: s for s in sinks}
        inputs = [e for e in parse_inputs(run(["pactl", "list", "sink-inputs"]), sink_by_index) if is_valid_input(e)]
        moved = 0
        for e in inputs:
            if e["sinkName"] == default:
                continue
            move(e["id"], default)
            moved += 1
        # Re-read rather than trust the moves: a stream can disappear, or the
        # move can be refused, between the call above and this check.
        after = parse_inputs(run(["pactl", "list", "sink-inputs"]), sink_by_index)
        stuck = [e for e in after if is_valid_input(e) and e["sinkName"] != default]
        if stuck:
            names = ", ".join(sorted({e.get("appName") or e.get("binary") or "?" for e in stuck}))
            restore_result("error", f"{len(stuck)} still routed")
            say_exit(f"restore: streams did not return to the default sink: {names}", "stuck")
            sys.exit(4)
        restore_result("ok", f"moved {moved} of {len(inputs)} to {default}")
        say(f"restore: moved {moved} of {len(inputs)} to {default}")
    finally:
        try:
            fcntl.flock(mark, fcntl.LOCK_UN)
        except OSError:
            pass
        mark.close()


def load_state():
    """The whole state file. Missing, unreadable, or wrong-shaped reads as
    empty: routing is on by default, a corrupt preference must not disable the
    plugin, and losing the label cache is harmless (it refills)."""
    try:
        with open(STATE, "r", encoding="utf-8") as f:
            obj = json.load(f)
    except (OSError, ValueError):
        return {}
    return obj if isinstance(obj, dict) else {}


def modify_state(mutator):
    """Read-modify-write the state file under the store lock.

    The on/off preference and the sink-label cache share this file and are
    written from different places — a user toggle, and the 1s `list` poll — so
    the write has to be a locked read-modify-write. Writing a whole document
    instead would let the poll drop a preference the user had just toggled, and
    vice versa. Refuses without the lock for the same reason modify_store does.
    """
    try:
        os.makedirs(os.path.dirname(STATE) or ".", exist_ok=True)
    except OSError as ex:
        say(f"state: could not create {os.path.dirname(STATE)}: {ex}")
        wlog(f"refused state write: cannot create state dir: {ex}")
        return False
    fd = open_lock()
    if fd is None:
        say("state lock unavailable — refusing write")
        wlog("refused state write: no usable lock path")
        return False
    with fd:
        if not acquire_ex(fd):
            say("state lock unavailable — refusing write")
            wlog("refused state write: lock unavailable after 5s")
            return False
        before = load_state()
        after = mutator(dict(before))
        if after == before:
            return True
        try:
            # The state file holds the on/off preference and, since v1.3.2, a
            # cache of Bluetooth device names and MACs. That is device
            # identifying information, so it gets the same 0600 the rules store
            # already had; without this it was world-readable on a shared box.
            atomic_write(STATE, json.dumps(after, indent=2) + "\n")
        except OSError as ex:
            say(f"state: could not write {STATE}: {ex}")
            return False
    return True


def load_routing_state():
    """Persisted on/off intent. Absent or unreadable means on: routing is the
    default, and a corrupt preference file must not silently disable the
    plugin."""
    return bool(load_state().get("routing_enabled", True))


def cmd_routing_state():
    print("on" if load_routing_state() else "off")


def cmd_set_routing(value):
    want = str(value).strip().lower()
    if want not in ("on", "off"):
        say(f"set-routing: expected 'on' or 'off', got {value!r}")
        sys.stdout.write("ROUTING_STATE error bad value\n")
        sys.stdout.flush()
        sys.exit(2)
    if not modify_state(lambda obj: {**obj, "routing_enabled": want == "on"}):
        sys.stdout.write("ROUTING_STATE error could not write\n")
        sys.stdout.flush()
        sys.exit(1)
    say(f"set-routing: routing {want}")
    sys.stdout.write(f"ROUTING_STATE {want}\n")
    sys.stdout.flush()



def cmd_set(app, binary, node, sink_name, move=True):
    app = app or ""
    node = node or ""
    key = key_of_r({"app": app, "binary": binary, "node": node})
    target = "__default__" if (not sink_name or sink_name == "__default__") else sink_name
    verb = "moved" if move else "stored"
    say(f"set-sink {verb} key={key!r} app={app!r} binary={binary!r} node={node!r} sink={target}")

    modify_store(lambda rules: replace_rule(rules, app, binary, node, target))
    if not move:
        # Routing is off: the rule is kept for the next switch-on, but no
        # stream is touched now.
        return
    actual = target if target != "__default__" else run(["pactl", "get-default-sink"]).strip()
    move_matching(app, binary, node, actual)


def cmd_set_rule(app, binary, node, sink_name):
    cmd_set(app, binary, node, sink_name, move=False)


def cmd_remove(app_or_binary):
    cmd_set(app_or_binary, "", "", "__default__")



def move_matching(app, binary, node, target):
    sinks = parse_sinks(run(["pactl", "list", "sinks"]))
    sink_by_index = {s["index"]: s for s in sinks}
    inputs = parse_inputs(run(["pactl", "list", "sink-inputs"]), sink_by_index)
    eff = effective_sink(target, sinks)
    if not eff:
        say(f"sink {target!r} missing and no default available; skipping moves")
        return
    if eff != target:
        say(f"sink missing ({target}) -> default ({eff})")
    rule = {"app": app, "binary": binary, "node": node, "sink": eff}
    for e in inputs:
        if not is_valid_input(e):
            continue
        if match_rule(e, [rule]) and e["sinkName"] != eff:
            move(e["id"], eff)


def cmd_watch():
    # Brief startup grace: the engine's Process tracker needs a moment to
    # observe "running" before the child exits cleanly, otherwise an instant
    # flock-conflict exit can be lost by the tracker and leave the widget's
    # process wedged in limbo. 0.4s is well inside the 0.5s poll cadence.
    time.sleep(0.4)
    mark = open(WATCH_MARK, "w")
    # Wait out a stale holder instead of exiting at once: on a plugin reload the
    # previous watcher legitimately holds the flock for a fraction of a second
    # while it winds down. A bounded poll lets that overlap resolve cleanly;
    # only a genuinely live second instance outlasts the window and gets exit 3.
    for _ in range(10):
        try:
            fcntl.flock(mark, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            time.sleep(0.2)
    else:
        say_exit("watch: another watcher is already running", "flock")
        sys.exit(3)
    parent = os.getppid()
    try:
        os.unlink(LOG)
    except OSError:
        pass
    say(f"watch: started (parent {parent}, store {STORE})")
    traced = {}
    missing_reported = {}
    error_last = {}
    # The off switch was enforced only in QML, which left the actual side effect
    # unguarded: a watcher started by a stale panel, by hand, or by anything
    # else kept moving streams after the user had switched routing off. The
    # preference is read here, where the move happens, so it holds no matter who
    # started the process. Default stays "on" — see load_routing_state.
    off_logged = False
    # Monotonic deadline until which the fast cadence is kept in force, pushed
    # forward every time a stream is seen. Starts at 0 so a session that never
    # plays anything polls slowly from the first pass. See poll_delay.
    active_until = 0.0
    while True:
        delay = POLL_ACTIVE
        try:
            if os.getppid() != parent:
                say_exit("watch: parent is gone — exiting", "parent")
                sys.exit(3)
            if not load_routing_state():
                # Idle rather than exit: a panel that reopens would otherwise
                # restart us in a loop, and the parent may be about to stop us
                # deliberately. Nothing is spawned, so the cost is one small
                # read of the preference file per poll.
                if not off_logged:
                    off_logged = True
                    say("watch: routing is off — watcher idle")
                    wlog("routing is off; watcher idle (not steering)")
                time.sleep(POLL_IDLE)
                continue
            off_logged = False
            now = time.monotonic()
            rules = read_store_locked()
            # Bound before use: the cadence below is computed whether or not any
            # rules exist, and with no rules nothing below ever assigns inputs.
            inputs = []
            if rules:
                sinks = parse_sinks(run(["pactl", "list", "sinks"]))
                sink_by_index = {s["index"]: s for s in sinks}
                inputs = [e for e in parse_inputs(run(["pactl", "list", "sink-inputs"]), sink_by_index) if is_valid_input(e)]
                # Only real streams count as activity. A session with rules but
                # nothing playing is the common case, and that is the case that
                # gets to poll slowly. The deadline starts at 0, so a watcher
                # that never sees a stream never lingers without needing a
                # separate flag to clear it.
                if inputs:
                    active_until = now + POLL_LINGER
                moved = 0
                for e in inputs:
                    r = match_rule(e, rules)
                    if not r or not r.get("sink"):
                        if r is None:
                            # Once per stream, not once every 10s. Whether an app
                            # matches a rule does not change between polls, so
                            # the repeat only ever added log volume: a session
                            # with a few unroutable apps filled hundreds of
                            # kilobytes saying the same thing. If a rule for that
                            # app appears later, the stream starts moving and
                            # "rules reasserted (n)" says so.
                            tk = norm(basename(e.get("binary", ""))) or norm(basename(e.get("nodeName", ""))) or norm(e.get("appName", ""))
                            if len(traced) < 512 and tk not in traced:
                                traced[tk] = True
                                wlog(f"no rule match: app={e.get('appName','')!r} bin={e.get('binary','')!r} node={e.get('nodeName','')!r}")
                        continue
                    if r["sink"] == "__default__":
                        continue
                    eff = effective_sink(r["sink"], sinks)
                    if not eff:
                        continue
                    if eff != r["sink"]:
                        if r["sink"] not in missing_reported and len(missing_reported) < 128:
                            missing_reported[r["sink"]] = True
                            wlog(f"sink missing ({r['sink']}) -> default ({eff})")
                    else:
                        missing_reported.pop(r["sink"], None)
                    if e["sinkName"] == eff:
                        continue
                    move(e["id"], eff)
                    moved += 1
                if moved:
                    wlog(f"rules reasserted ({moved} stream{'s' if moved != 1 else ''})")
            delay = poll_delay(bool(inputs), time.monotonic(), active_until)
        except Exception as ex:
            say(f"watch: poll error: {ex}")
            if due(error_last.get("poll"), time.monotonic(), 10):
                error_last["poll"] = time.monotonic()
                wlog(f"poll error: {ex}")
        time.sleep(delay)


