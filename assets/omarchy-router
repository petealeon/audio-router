def parse_js_list(js, name):
    """The string entries of a JS `var NAME = [ "a", "b" ]` in Model.js.

    Read as source text rather than executed: the selftest has no business
    running a JS engine, and node may not be installed where this runs. The
    pattern is deliberately narrow -- a single var initialised to a flat list of
    quoted strings -- so it cannot silently match something else later.
    """
    m = re.search(r"var\s+" + re.escape(name) + r"\s*=\s*\[(.*?)\]", js, re.S)
    if not m:
        return set()
    return {norm(x) for x in re.findall(r'"([^"]*)"', m.group(1))}


def load_exclusion_cases():
    """The shared exclusion table, or None when this copy has no scripts/ dir.

    install.sh ships the plugin files only, so an installed helper has no table.
    """
    path = os.path.normpath(os.path.join(
        os.path.dirname(os.path.abspath(__file__)), os.pardir, "scripts", "exclusion-cases.json"))
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)["cases"]
    except (OSError, ValueError, KeyError):
        return None


def selftest():
    """Zero-I/O sanity checks for the pure parsers and matchers.

    Every helper here runs on canned text only: no pactl, no store, no lock.
    Runs in CI or after a deploy: `omarchy-router selftest`.
    """
    checks = []

    # Swapped out (and restored in a finally) for the set-rule store/move
    # separation checks further down.
    global modify_store, move_matching, run, load_state, bluetooth_labels
    global load_rules, resolve_sink_labels

    def check(name, got, want):
        ok = got == want
        checks.append((name, ok))
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: {got!r}" + ("" if ok else f" (want {want!r})"))

    sinks = parse_sinks(CANONICAL_SINKS)
    check("parse_sinks count", len(sinks), 3)
    check("parse_sinks names", [s["name"] for s in sinks],
          ["alsa_output.pci-0000_00_1f.3.analog-stereo", "bluez_output.24_06_11_A5_E7_95.1",
           "alsa_output.usb-Generic_ThinkPad_Dock_USB_Audio-00.analog-stereo"])
    check("parse_sinks availability", [s["available"] for s in sinks], [True, True, True])

    sink_by_index = {s["index"]: s for s in sinks}
    inputs = parse_inputs(CANONICAL_INPUTS, sink_by_index)
    check("parse_inputs count", len(inputs), 3)
    check("parse_inputs binary basename", [e["binary"] for e in inputs], ["brave", "mpv", "signal-desktop"])
    check("parse_inputs sinkName", [e["sinkName"] for e in inputs],
          ["alsa_output.usb-Generic_ThinkPad_Dock_USB_Audio-00.analog-stereo",
           "bluez_output.24_06_11_A5_E7_95.1", "alsa_output.pci-0000_00_1f.3.analog-stereo"])
    check("parse_inputs volume (%)", [e["volume"] for e in inputs], [1.0, 0.6, 0.5])
    check("parse_inputs muted", [e["muted"] for e in inputs], [False, False, True])

    target = "bluez_output.24_06_11_A5_E7_95.1"
    dflt = "alsa_output.usb-Generic_ThinkPad_Dock_USB_Audio-00.analog-stereo"
    check("effective_sink present", effective_sink(target, sinks, dflt), target)
    check("effective_sink missing->default", effective_sink("bluez_output.gone.1", sinks, dflt), dflt)
    check("effective_sink both absent", effective_sink("bluez_output.gone.1",
                                                       [s for s in sinks if s["name"] != dflt], "gone-default"), "")

    # --- bluetooth re-indexing must follow the device, not the profile ----
    # The bug this pins: the rule names ".1", the card came back as ".2", name
    # matching missed, and the app silently fell to the default sink while the
    # panel still showed it pinned to the headset. Replugging changed nothing,
    # because the rule failed the same name comparison every time.
    reindexed = [s for s in sinks if s["name"] != target]
    reindexed.append({"index": 41, "name": "bluez_output.24_06_11_A5_E7_95.2",
                      "desc": "MOONDROP BLOCK", "available": True})
    check("same_device_sink follows MAC across profiles",
          same_device_sink("bluez_output.24_06_11_A5_E7_95.1", reindexed), "bluez_output.24_06_11_A5_E7_95.2")
    check("effective_sink re-indexed device stays on bluetooth",
          effective_sink("bluez_output.24_06_11_A5_E7_95.1", reindexed, dflt), "bluez_output.24_06_11_A5_E7_95.2")
    # And the reverse direction: rule says ".2", card came back as ".1".
    check("effective_sink re-indexed forward",
          effective_sink("bluez_output.24_06_11_A5_E7_95.2", sinks, dflt), target)
    # Suffix optional, per the v1.3.2 tolerance.
    check("same_device_sink tolerates missing profile index",
          same_device_sink("bluez_output.24_06_11_A5_E7_95", reindexed), "bluez_output.24_06_11_A5_E7_95.2")
    # A different device must not match, and neither must a wired sink: sending
    # audio to a speaker the rule never named is worse than falling back.
    check("same_device_sink rejects a different MAC",
          same_device_sink("bluez_output.23_10_18_B3_17_FD.1", reindexed), "")
    check("same_device_sink rejects a wired target",
          same_device_sink("alsa_output.usb-Generic_ThinkPad_Dock_USB_Audio-00.analog-stereo", reindexed), "")
    check("same_device_sink rejects empty target", same_device_sink("", reindexed), "")
    check("same_device_sink rejects None target", same_device_sink(None, reindexed), "")
    check("same_device_sink with no sinks", same_device_sink(target, []), "")
    check("effective_sink still falls back for a genuinely absent device",
          effective_sink("bluez_output.23_10_18_B3_17_FD.1", reindexed, dflt), dflt)
    # A hand-edited rules file may spell the MAC in lower case; it is still the
    # same device. (PipeWire always emits the lower-case "bluez_output"
    # prefix, so only the hex digits vary in practice.)
    check("same_device_sink normalises MAC hex case",
          same_device_sink("bluez_output.24_06_11_a5_e7_95.9", reindexed), "bluez_output.24_06_11_A5_E7_95.2")
    # Two profiles of one card live at once: lowest index wins, deterministically,
    # so the watcher does not flip between them on alternating polls.
    both = reindexed + [{"index": 42, "name": "bluez_output.24_06_11_A5_E7_95.3",
                        "desc": "MOONDROP BLOCK", "available": True}]
    for _ in range(4):
        check("same_device_sink prefers lowest profile when several are live",
              same_device_sink("bluez_output.24_06_11_A5_E7_95.1", both), "bluez_output.24_06_11_A5_E7_95.2")
    check("bluetooth_profile_index parses", bluetooth_profile_index("bluez_output.24_06_11_A5_E7_95.2"), 2)
    # Profile 10 must order after profile 2, not before: comparing the suffixes
    # as strings puts ".10" first and would hand the stream to the wrong
    # profile of the same card.
    check("bluetooth_profile_index is numeric not lexical",
          bluetooth_profile_index("bluez_output.24_06_11_A5_E7_95.10"), 10)
    tenth = [{"index": 41, "name": "bluez_output.24_06_11_A5_E7_95.10", "desc": "MOONDROP BLOCK", "available": True},
             {"index": 42, "name": "bluez_output.24_06_11_A5_E7_95.2", "desc": "MOONDROP BLOCK", "available": True}]
    check("profile 2 is chosen over profile 10",
          same_device_sink("bluez_output.24_06_11_A5_E7_95.1", tenth), "bluez_output.24_06_11_A5_E7_95.2")

    # The panel needs to know about the re-index too, or it draws the live ".2"
    # row *and* a ghost row for the rule's ".1": one headset twice, and a claim
    # that the app was never routed.
    r1 = {"app": "mpv", "binary": "mpv", "node": "", "sink": "bluez_output.24_06_11_A5_E7_95.1"}
    r2_ = {"app": "brave", "binary": "brave", "node": "", "sink": dflt}
    r3 = {"app": "signal-desktop", "binary": "signal-desktop", "node": "",
          "sink": "bluez_output.23_10_18_B3_17_FD.1"}
    r4 = {"app": "firefox", "binary": "firefox", "node": "", "sink": "__default__"}
    check("sink_alias_map maps the re-indexed rule",
          sink_alias_map([r1, r2_, r3, r4], reindexed),
          {"bluez_output.24_06_11_A5_E7_95.1": "bluez_output.24_06_11_A5_E7_95.2"})
    # A device that is genuinely gone keeps its ghost row: that row is how the
    # user finds out their headset is unplugged.
    check("sink_alias_map omits an absent device",
          sink_alias_map([r3], reindexed), {})
    check("sink_alias_map omits a satisfied wired rule", sink_alias_map([r2_], reindexed), {})
    check("sink_alias_map omits __default__", sink_alias_map([r4], reindexed), {})
    check("sink_alias_map omits a rule already live",
          sink_alias_map([{"app": "mpv", "binary": "mpv", "node": "", "sink": dflt}], reindexed), {})
    check("sink_alias_map with no rules", sink_alias_map([], reindexed), {})
    check("sink_alias_map with no sinks", sink_alias_map([r1], []), {})
    check("sink_alias_map tolerates a rule with no sink key",
          sink_alias_map([{"app": "mpv", "binary": "mpv", "node": ""}], reindexed), {})
    check("sink_alias_map tolerates a null sink", sink_alias_map([{"app": "mpv", "sink": None}], reindexed), {})

    # --- the off switch must be enforced where the move happens ------------
    # cmd_watch is an infinite loop that talks to real pactl, so it cannot be
    # invoked here. What matters is structural: the preference has to be read
    # before anything is spawned and before any stream is moved, or the switch
    # is decorative. Asserting the order in the source is the honest way to pin
    # that without a live audio session.
    with open(os.path.abspath(__file__), encoding="utf-8") as f:
        _src = f.read()
    _watch = _src[_src.index("def cmd_watch"):]
    _watch = _watch[:_watch.index("\ndef ", 1)]

    def _at(needle):
        """Offset of `needle` in the watcher source, or -1 when absent.

        -1 rather than a raised ValueError on purpose: a refactor that removes
        one of these constructs should produce a named failure, not a traceback
        that takes the rest of the suite down with it and hides which of the
        other checks still hold.
        """
        return _watch.find(needle)

    def _before(first, second):
        """True when `first` appears, and appears before `second`."""
        a, b = _at(first), _at(second)
        return a != -1 and b != -1 and a < b

    check("watch: reads the routing preference", _watch.count("load_routing_state()") >= 1, True)
    # The gate must be a live conditional on that preference, not merely a call
    # somewhere above: "if False and not load_routing_state():" would satisfy
    # every ordering check below while steering every stream regardless.
    check("watch: off gate is a live conditional on the preference",
          _watch.count("if not load_routing_state():") >= 1, True)
    check("watch: no disabled gate",
          [ln.strip() for ln in _watch.splitlines()
           if "load_routing_state()" in ln and "if not" in ln
           and not ln.strip().startswith("if not load_routing_state():")], [])
    check("watch: consults the preference before reading rules",
          _before("load_routing_state()", "read_store_locked()"), True)
    check("watch: consults the preference before spawning pactl",
          _before("load_routing_state()", 'run(["pactl", "list", "sinks"])'), True)
    check("watch: consults the preference before moving a stream",
          _before("load_routing_state()", 'move(e["id"], eff)'), True)
    # Idling must not cost a pactl call: the gate returns to sleep immediately.
    check("watch: idles on the off branch",
          _before("time.sleep(POLL_IDLE)", 'run(["pactl", "list", "sinks"])'), True)
    # Announced once, not once per poll, or a long idle session floods the log.
    check("watch: logs the idle state once", _watch.count("off_logged = True"), 1)
    check("watch: resets the latch when re-enabled", _watch.count("off_logged = False") >= 1, True)

    # Unroutable streams are reported once each, not re-reported on a timer.
    # Re-logging every 10s said the same thing ~13 MB/day on tmpfs without ever
    # adding information: whether an app matches a rule does not change between
    # polls, and a later match is already covered by "rules reasserted (n)".
    check("watch: reports an unmatched stream once", _watch.count("tk not in traced") >= 1, True)
    check("watch: marks the stream as reported, not timestamped",
          _watch.count("traced[tk] = True") >= 1, True)
    check("watch: no timed re-report of unmatched streams",
          "traced.get(tk, 0)" in _watch, False)
    check("watch: unmatched streams stay bounded", _watch.count("len(traced) < 512") >= 1, True)

    # --- adaptive cadence -------------------------------------------------
    # Pure, so the policy is testable without a session. Two properties matter:
    # audio playing means the fast cadence, and silence means the slow one.
    check("poll_delay: fast while something plays", poll_delay(True, 1000.0, 0.0), POLL_ACTIVE)
    check("poll_delay: slow when silent", poll_delay(False, 1000.0, 0.0), POLL_IDLE)
    check("poll_delay: fast is faster than slow", POLL_ACTIVE < POLL_IDLE, True)
    # Linger: the deadline keeps the fast cadence for a moment after the last
    # stream, so a pause between tracks cannot drop us to slow and then miss
    # the next track arriving inside the gap.
    check("poll_delay: lingers fast just after the last stream",
          poll_delay(False, 1000.0, 1000.0 + POLL_LINGER - 0.1), POLL_ACTIVE)
    check("poll_delay: stops lingering once the deadline passes",
          poll_delay(False, 1000.0 + POLL_LINGER + 0.1, 1000.0 + POLL_LINGER), POLL_IDLE)
    # Simulate real loop progression: a stream is seen, then time passes at the
    # fast cadence. The linger window is POLL_LINGER long, so the fast cadence
    # must hold for exactly that many polls and then give way.
    _seen_at = 1000.0
    _deadline = _seen_at + POLL_LINGER
    _polls = int(POLL_LINGER / POLL_ACTIVE) + 4
    _delays = [poll_delay(False, _seen_at + _i * POLL_ACTIVE, _deadline) for _i in range(_polls)]
    _fast_count = sum(1 for d in _delays if d == POLL_ACTIVE)
    check("poll_delay: fast for exactly the linger window", _fast_count, int(POLL_LINGER / POLL_ACTIVE))
    check("poll_delay: slow for every poll after it", _delays[_fast_count:], [POLL_IDLE] * (_polls - _fast_count))
    check("poll_delay: slow once the linger window is over",
          poll_delay(False, _seen_at + POLL_LINGER + 0.1, _deadline), POLL_IDLE)
    check("poll_delay: deadline exactly at now is not lingering",
          poll_delay(False, 1000.0, 1000.0), POLL_IDLE)
    check("poll_delay: a stream always wins over a stale deadline",
          poll_delay(True, 1000.0, 1.0), POLL_ACTIVE)
    check("poll_delay: linger is longer than the slow cadence",
          POLL_LINGER > POLL_IDLE, True)
    check("poll_delay: cadence values are sane", 0 < POLL_ACTIVE <= 1.0 < POLL_IDLE <= 10.0, True)
    # A caller that passes a zero deadline and no streams must not hang or
    # return something nonsensical.
    check("poll_delay: zero deadline, no streams", poll_delay(False, 0.0, 0.0), POLL_IDLE)
    # The loop must not read `inputs` before the branch that binds it. With no
    # rules the pactl block is skipped entirely, and the cadence line still
    # runs, so an unbound name here would raise every single poll.
    check("watch: binds inputs before the cadence line uses it",
          _before("inputs = []", "delay = poll_delay("), True)
    check("watch: cadence line reads the rebound inputs",
          "delay = poll_delay(bool(inputs)" in _watch, True)
    check("watch: no fixed 0.5s sleep left in the loop",
          "time.sleep(0.5)" in _watch, False)
    check("watch: the loop sleeps on the computed delay", "time.sleep(delay)" in _watch, True)
    check("watch: lingers after the last stream",
          _watch.count("active_until = now + POLL_LINGER") >= 1, True)
    # Initialised before the loop, so a watcher that never sees a stream never
    # lingers and polls slowly from the first pass.
    check("watch: linger deadline starts at zero",
          _before("active_until = 0.0", "while True:"), True)

    # --- the watcher log must stay bounded ---------------------------------
    # It lives on tmpfs, so an unbounded log is memory the session never
    # recovers. wlog is pure enough to test against a temp path.
    _real_log, _real_cap = LOG, LOG_MAX_BYTES
    _td = tempfile.mkdtemp()
    try:
        # Rebind through globals(): a plain assignment here would make LOG a
        # local of selftest() and break the read just above.
        globals()["LOG"] = os.path.join(_td, "watch.log")
        globals()["LOG_MAX_BYTES"] = 512

        wlog("first line")
        check("wlog: wrote a line", os.path.getsize(LOG) > 0, True)
        check("wlog: timestamped prefix", open(LOG, encoding="utf-8").readline().startswith("["), True)
        check("wlog: first generation has no rotation", os.path.exists(LOG + ".1"), False)

        wlog("second line")
        check("wlog: appends", len(open(LOG, encoding="utf-8").readlines()), 2)

        # Cross the cap: the current file rotates, one generation is kept.
        for i in range(40):
            wlog(f"filler {i}")
        check("wlog: keeps the log within the cap", os.path.getsize(LOG) < LOG_MAX_BYTES, True)
        check("wlog: keeps exactly one previous generation", os.path.exists(LOG + ".1"), True)
        check("wlog: previous generation is bounded", os.path.getsize(LOG + ".1") < LOG_MAX_BYTES, True)
        check("wlog: rotation preserved earlier content",
              "first line" in open(LOG + ".1", encoding="utf-8").read(), True)
        check("wlog: newest lines survive rotation", "filler 39" in open(LOG, encoding="utf-8").read(), True)

        # Soak: the invariant has to hold for every generation, not just the
        # first rotation. This is the shape of a real session — thousands of
        # appends over hours, with tmpfs memory as the budget.
        globals()["LOG"] = os.path.join(_td, "soak.log")
        wlog("seed")
        for i in range(500):
            wlog(f"poll {i}: no rule match: app='Some App' bin='/usr/bin/some-app'")
        check("wlog: soak keeps the current generation bounded",
              os.path.getsize(LOG) <= LOG_MAX_BYTES, True)
        check("wlog: soak keeps the previous generation bounded",
              os.path.getsize(LOG + ".1") <= LOG_MAX_BYTES, True)
        check("wlog: soak total footprint is bounded",
              os.path.getsize(LOG) + os.path.getsize(LOG + ".1") <= 2 * LOG_MAX_BYTES, True)
        check("wlog: soak kept the newest line", "poll 499" in open(LOG, encoding="utf-8").read(), True)

        # A single pathological line must not be able to exceed the cap.
        wlog("x" * (LOG_MAX_BYTES * 4))
        check("wlog: oversized line is truncated", os.path.getsize(LOG) < LOG_MAX_BYTES, True)
        check("wlog: oversized line is marked", "truncated" in open(LOG, encoding="utf-8").read(), True)

        # A log that cannot be written must never take the watcher down.
        globals()["LOG"] = os.path.join(_td, "no-such-dir", "watch.log")
        wlog("into the void")
        check("wlog: survives an unwritable path", True, True)
    finally:
        globals()["LOG"] = _real_log
        globals()["LOG_MAX_BYTES"] = _real_cap
        for _f in (os.path.join(_td, "watch.log"), os.path.join(_td, "watch.log.1"),
               os.path.join(_td, "soak.log"), os.path.join(_td, "soak.log.1")):
            try:
                os.unlink(_f)
            except OSError:
                pass
        try:
            os.rmdir(_td)
        except OSError:
            pass
    check("wlog: restored the real log path", LOG, _real_log)
    check("wlog: restored the real cap", LOG_MAX_BYTES, _real_cap)
    check("wlog: cap is a sane size", 16 * 1024 <= LOG_MAX_BYTES <= 4 * 1024 * 1024, True)

    # --- hardening: permissions, lock fallback, corrupt-once -------------
    # The state file caches Bluetooth device names and MACs, which is
    # identifying information; it was 0644 (world-readable) while the rules
    # beside it were already 0600.
    _td2 = tempfile.mkdtemp()
    _real_store, _real_state, _real_lock = STORE, STATE, LOCK
    try:
        globals()["STORE"] = os.path.join(_td2, "router-rules.json")
        globals()["STATE"] = os.path.join(_td2, "petealeon-router.json")
        globals()["LOCK"] = os.path.join(_td2, "store.lock")

        def set_pref(obj):
            return {**obj, "routing_enabled": False}

        check("modify_state: wrote the preference", modify_state(set_pref), True)
        _mode = os.stat(STATE).st_mode & 0o777
        check("modify_state: state file is 0600", oct(_mode), oct(0o600))
        check("modify_state: state file is not group or world readable", _mode & 0o077, 0)
        check("modify_state: no temp file left behind",
              [f for f in os.listdir(_td2) if ".tmp." in f], [])
        check("modify_state: lock was created", os.path.exists(LOCK), True)
        check("load_state: reads back the preference", load_state().get("routing_enabled"), False)

        # The rules store keeps its own 0600.
        write_rules([{"app": "mpv", "binary": "mpv", "node": "", "sink": target}])
