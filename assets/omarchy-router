    # Model.js is unit-tested, but the panel's use of it is not reachable from
    # node: buildRows() is inline in a .qml file. These are source-level checks,
    # the same kind this suite already makes against Panel.qml, and they exist
    # because the fold is the fix. Reverting the call in Panel.qml would leave
    # every unit test green while the duplicate row came straight back.
    try:
        with open(model_js, encoding="utf-8") as f:
            model_src = f.read()
        with open(os.path.normpath(os.path.join(
                os.path.dirname(os.path.abspath(__file__)), os.pardir, "Panel.qml")),
                encoding="utf-8") as f:
            panel_src = f.read()
        check("Panel.qml folds rows with Model.mergeRows",
              panel_src.count("Model.mergeRows("), 1)
        # The one QML copy of the denylist moved into Model.js. Its presence
        # here again is what let the two drift. Matched on the shape it had --
        # a var initialised to a list of quoted names -- rather than on any
        # "var list = [", which an unrelated empty list also matches.
        check("Panel.qml holds no denylist of its own",
              re.findall(r'var\s+\w*[Ll]ist\w*\s*=\s*\[\s*"', panel_src), [])
        check("Panel.qml filters rules through the shared predicate",
              panel_src.count("Model.isExcludedClient("), 2)
        # Every row labels through one function. buildRows() names a row from
        # three kinds of record -- a stream, a pin, and a client with no stream --
        # and an ALSA application is called "PipeWire ALSA [app]" in all three,
        # so a label taken from any other expression reads "PipeWire ALSA
        # [cliamp]" and looks like a piece of the audio stack rather than the
        # player it is. The fourth call is the runIdle label upgrade, which
        # rewrites an existing row's label and must not reintroduce the wrapper.
        # Not reachable from node, like the fold above, so guarded as source.
        check("Panel.qml labels every row through friendlyLabel",
              panel_src.count("Model.friendlyLabel("), 4)

        # ---- layout: the circle and the two row grids -----------------------
        # Same reasoning as the fold above: none of this is reachable from node,
        # and each of these is a way the layout can silently regress while every
        # unit test still passes.

        def qml_strip_comments(text):
            """QML source with // comments and /* */ blocks removed.

            The layout guards assert on the absence of a token, so a comment
            that merely *names* that token fails the check for the wrong reason.
            Worse, it would start passing again the moment the comment is
            reworded while the code underneath stayed broken -- a guard that
            reads prose returns an answer that depends on how the fix was
            written up rather than on what the code does. These have to see code
            only.

            String literals are copied through untouched, which takes real
            care rather than a regex: Panel.qml contains "file://" and
            backticks, so a stripper that treated any "//" as a comment would
            quietly truncate those lines and hand a later guard a function body
            that ends mid-expression.
            """
            out = []
            i, n = 0, len(text)
            while i < n:
                ch = text[i]
                if ch in "\"'`":
                    # Copy the whole literal, honouring backslash escapes, so
                    # an escaped quote cannot end it early.
                    quote = ch
                    out.append(ch)
                    i += 1
                    while i < n:
                        c = text[i]
                        out.append(c)
                        i += 1
                        if c == "\\" and i < n:
                            out.append(text[i])
                            i += 1
                        elif c == quote:
                            break
                    continue
                two = text[i:i + 2]
                if two == "//":
                    nl = text.find("\n", i)
                    i = n if nl < 0 else nl
                elif two == "/*":
                    end = text.find("*/", i + 2)
                    i = n if end < 0 else end + 2
                    # Keep a space so stripping cannot glue two tokens together
                    # and invent one that was never in the source.
                    out.append(" ")
                else:
                    out.append(ch)
                    i += 1
            return "".join(out)

        def qml_fn(name):
            """The source text of one Panel.qml function, braces balanced."""
            start = panel_src.find("  function %s(" % name)
            if start < 0:
                return ""
            i = panel_src.find("{", start)
            depth = 0
            while i < len(panel_src):
                if panel_src[i] == "{":
                    depth += 1
                elif panel_src[i] == "}":
                    depth -= 1
                    if depth == 0:
                        return qml_strip_comments(panel_src[start:i + 1])
                i += 1
            return ""

        def qml_block(ident):
            """The source text of the QML block carrying `id: ident`."""
            at = panel_src.find("id: %s" % ident)
            if at < 0:
                return ""
            start = panel_src.rfind("{", 0, at)
            i = panel_src.find("{", start)
            depth = 0
            while i < len(panel_src):
                if panel_src[i] == "{":
                    depth += 1
                elif panel_src[i] == "}":
                    depth -= 1
                    if depth == 0:
                        return qml_strip_comments(panel_src[start:i + 1])
                i += 1
            return ""

        # The circle moved next to its name, so nothing may position it from the
        # column edge any more. It used to be appCol.width - appGutter - 3.
        check("the drawn circle's x comes from the shared formula",
              "root.appDotXForWidth(" in qml_block("appDot"), True)
        check("the removed right-hand gutter is gone with it",
              "appGutter" in panel_src, False)
        # The ring's hitbox, the patch line's endpoint and the drag ghost all
        # read where the delegate actually drew the circle, so they cannot
        # disagree with it. Three readers: badgeHit, dotCenterFor, the ghost.
        check("the circle's position has one owner and three readers",
              panel_src.count("root.appDotXFor("), 3)
        # The patch grid shares one row height across both columns. Output rows
        # are two lines tall and set the 32px floor (rowH and outRowH are the
        # same property now). Anything that turns an *index* into a y still has
        # to use the output step, because both columns index their own array --
        # but the two steps must stay numerically equal, so a same-level source
        # and output sit on the same line.
        check("outRowH is derived from rowH, not restated",
              "readonly property int outRowH: root.rowH" in panel_src, True)
        check("and both rows come from one 32px source",
              bool(re.search(r"readonly property int rowH: Style\.space\(32\)", panel_src)),
              True)
        check("output hit-testing indexes by the output row step",
              bool(re.search(r"Math\.floor\(y\s*/\s*root\.outRowStep\)", qml_fn("outputAt"))),
              True)
