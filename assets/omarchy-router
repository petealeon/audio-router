    #
    # decoded() routes every assertion through the exception boundary: without
    # it a regression to strict decoding raises out of the first case and kills
    # the whole suite, which reports no result at all instead of naming the
    # check that broke.
    def decoded(raw):
        try:
            return decode_output(raw)
        except Exception as ex:
            return f"raised {type(ex).__name__}"

