        # the wrong divisor: the y range and the index both used the app row
        # step, so the row a snap drag landed on depended on how tall the other
        # column's rows happened to be. Both must be guarded together -- fixing
        # only the index would leave the range still ending early.
        check("snap hit-testing indexes by the output row step too",
              bool(re.search(r"Math\.floor\(y\s*/\s*root\.outRowStep\)", qml_fn("snapOutputAt"))),
              True)
        check("snap hit-testing bounds the y range by the output row step",
              "root.outputRows.length * root.outRowStep" in qml_fn("snapOutputAt"), True)
        check("snap hit-testing never divides y by the app row step",
              "root.rowStep" in qml_fn("snapOutputAt"), False)
        check("the output dot's y uses the output row step",
              "root.outRowStep" in qml_fn("dotCenterFor"), True)
        check("scrolling the cursor uses the step of the column it is in",
              'root.cursorSection === "outputs" ? root.outRowStep' in qml_fn("ensureCursorVisible"),
              True)
        # Shortcut badges. Sources take letters a-z first, in row order;
        # outputs 1-9 take digits; outputs past #9 take the alphabet tail the
        # sources did not use. j/k/h/l/x never reach the panel (the shell's key
        # catcher claims them for movement/delete) and r is reserved for the
        # routing toggle, so no row may be badged with any of those six -- the
        # badge must show exactly what pressing the key actually does.
        check("the shared shortcut pool is allocated from the sources upward",
              "shortcutLetters" in panel_src and "shortcutTail" in panel_src, True)
        check("sources and outputs may not claim j/k/h/l/x or the routing r",
              'readonly property string reservedShortcuts: "jkhlxr"' in panel_src, True)
        # The letter keys feed two functions: a source select (which also arms
        # selectKey so the chosen row stays visibly picked) and an output-tail
        # route for outputs past #9. A letter must mean at most one thing --
        # sources get first pick, so a tail letter can never shadow a source.
        check("a letter press selects a source and arms it for routing",
              "root.appCursorKey = root.appRows[i].key" in qml_fn("selectSourceByLetter"), True)
        check("and marks it selected so the highlight outlives the mouse",
              "root.selectKey = root.appRows[i].key" in qml_fn("selectSourceByLetter"), True)
        check("an output past #9 is reached by its leftover letter",
              "root.shortcutTail[t]" in qml_fn("routeByOutputLetter"), True)
        # Wiring: r toggles the watcher, letters go source-first then output,
        # digits keep their existing quick-route meaning. If someone reorders
        # the catcher so r routes instead of toggling, the first guard here
        # fails.
        catcher = qml_block("keyCatcher")
        check("r toggles routing when the panel is focused",
              "t === \"r\"" in catcher and "toggleRoutingFromCursor()" in catcher, True)
        check("a letter press tries the source and falls back to the output",
              "selectSourceByLetter(t)" in catcher and "routeByOutputLetter(t)" in catcher, True)
        check("1-9 still quick-route the current source",
              "root.quickRouteCursor(t)" in catcher, True)
        # Both row kinds draw a badge chip that reports exactly the key that
        # reaches them, so the label and the handler can never drift apart.
        check("source rows render their shortcut letter",
              "root.sourceBadge(model.index)" in panel_src, True)
        check("output rows render their shortcut number or letter",
              "root.outputBadge(model.index)" in panel_src, True)
        # Following the shortcut means following the keyboard cursor, so the
        # badge letter for a source has to line up with the row the letter
        # handler lands on (same index, same appRows array).
        check("every source row that gets a letter is selectable by it",
              "root.shortcutLetters.length" in qml_fn("selectSourceByLetter"), True)
        # The badges are keycaps: a letter/number on a filled square, so the hint
        # reads as a key instead of as text that belongs to the row. Alpha lives
        # on the fill (badgeFill), not on a container opacity, or the letter
        # would dim with the box -- and the row fills use the same trick, so a
