def selftest():
    """Zero-I/O sanity checks for the pure parsers and matchers.

    Every helper here runs on canned text only: no pactl, no store, no lock.
    Runs in CI or after a deploy: `omarchy-router selftest`.
    """
    checks = []

    def check(name, got, want):
        ok = got == want
        checks.append((name, ok))
        print(f"  {'PASS' if ok else 'FAIL'}  {name}: {got!r}" + ("" if ok else f" (want {want!r})"))

    sinks = parse_sinks(CANONICAL_SINKS)
    check("parse_sinks count", len(sinks), 3)
    check("parse_sinks names", [s["name"] for s in sinks],
          ["alsa_output.pci-0000_00_1f.3.analog-stereo", "bluez_output.24_06_11_A5_E7_95.1",
           "alsa_output.usb-Generic_ThinkPad_Dock_USB_Audio-00.analog-stereo"])
    check("parse_sinks availability", [s["available"] for s in sinks], [True, True, True])

    sink_by_index = {s["index"]: s for s in sinks}
    inputs = parse_inputs(CANONICAL_INPUTS, sink_by_index)
    check("parse_inputs count", len(inputs), 3)
    check("parse_inputs binary basename", [e["binary"] for e in inputs], ["brave", "mpv", "signal-desktop"])
    check("parse_inputs sinkName", [e["sinkName"] for e in inputs],
          ["alsa_output.usb-Generic_ThinkPad_Dock_USB_Audio-00.analog-stereo",
           "bluez_output.24_06_11_A5_E7_95.1", "alsa_output.pci-0000_00_1f.3.analog-stereo"])
    check("parse_inputs volume (%)", [e["volume"] for e in inputs], [1.0, 0.6, 0.5])
    check("parse_inputs muted", [e["muted"] for e in inputs], [False, False, True])

    target = "bluez_output.24_06_11_A5_E7_95.1"
    dflt = "alsa_output.usb-Generic_ThinkPad_Dock_USB_Audio-00.analog-stereo"
    check("effective_sink present", effective_sink(target, sinks, dflt), target)
    check("effective_sink missing->default", effective_sink("bluez_output.gone.1", sinks, dflt), dflt)
    check("effective_sink both absent", effective_sink("bluez_output.gone.1",
                                                       [s for s in sinks if s["name"] != dflt], "gone-default"), "")

    rules = [
        {"app": "Brave", "binary": "brave", "node": "", "sink": target},
        {"app": "mpv", "binary": "", "node": "mpv", "sink": target},
        {"app": "Signal", "binary": "", "node": "WebKitWebContent", "sink": dflt},
    ]
    check("match_rule binary", match_rule(inputs[0], rules)["sink"], target)
    check("match_rule node", match_rule(inputs[1], rules)["sink"], target)
    check("match_rule app(no bin)", match_rule({"appName": "Chromium", "binary": "", "nodeName": ""}, rules), None)
    check("key_of_r binary>node>app",
          [key_of_r(r) for r in rules], ["brave", "mpv", "webkitwebcontent"])

    drift_pin = {"app": "Brave", "binary": "brave", "node": ""}
    drift_stored = {"app": "Brave", "binary": "", "node": "Brave", "sink": "old-target"}
    check("identity drift still overlaps", identities_overlap(drift_pin, drift_stored), True)

    boot = [
        {"app": "mpv", "binary": "", "node": "mpv", "sink": "old"},
        {"app": "Signal", "binary": "signal-desktop", "node": "", "sink": "old"},
    ]
    merged = replace_rule(boot, "mpv", "", "mpv", "new")
    check("replace_rule replaces by identity", [r for r in merged if key_of_r(r) == "mpv"],
          [{"app": "mpv", "binary": "", "node": "mpv", "sink": "new"}])
    check("replace_rule keeps unrelated", sorted(key_of_r(r) for r in merged), ["mpv", "signal-desktop"])
    removed = replace_rule(boot, "mpv", "", "mpv", "__default__")
    check("replace_rule removes on __default__", [key_of_r(r) for r in removed], ["signal-desktop"])
    check("replace_rule unpinned sink never persisted", all(r["sink"] != "__default__" for r in removed), True)

    check("strip_input", strip_input("Signal input"), "Signal")
    check("basename", basename("/usr/lib/brave-bin/brave"), "brave")

    check("describe_issues clean", describe_issues("Sink #88", True), [])
    check("describe_issues no sinks", describe_issues("", True), ["pactl returned no sink data"])
    check("describe_issues pactl missing", describe_issues("Sink #88", False), ["pactl not found"])
    check("describe_issues pactl missing and no sinks", describe_issues("", False), ["pactl not found"])

    check("due first call", due(None, 500.0, 10), True)
    check("due before window", due(490.0, 495.0, 10), False)
    check("due at window edge", due(490.0, 500.0, 10), True)
    check("merge_issues dedupes", merge_issues(["a"], "a"), ["a"])
    check("merge_issues appends", merge_issues(["a"], "b"), ["a", "b"])
    check("merge_issues ignores empty", merge_issues(["a"], ""), ["a"])
    check("intentional exit contract",
          all(code in INTENTIONAL_EXITS for code in (0, 3, 15)) and
          9 not in INTENTIONAL_EXITS and 143 not in INTENTIONAL_EXITS, True)

    failed = [name for name, ok in checks if not ok]
    print(f"selftest: {len(checks) - len(failed)}/{len(checks)} passed")
    return 1 if failed else 0


def main():
    args = sys.argv[1:]
    if not args:
        say("usage: omarchy-router list | set-sink <app> <binary> <sink|__default__> | remove <app-or-binary> | watch | selftest")
        sys.exit(2)
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "set-sink" and len(rest) >= 4:
        cmd_set(rest[0], rest[1], rest[2], rest[3])
    elif cmd == "remove" and rest:
        cmd_remove(rest[0])
    elif cmd == "watch":
        cmd_watch()
    elif cmd == "selftest":
        sys.exit(selftest())
    else:
        say(f"unknown command or bad arguments: {cmd} {rest}")
        sys.exit(2)


if __name__ == "__main__":
    main()